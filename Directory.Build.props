<Project>
  <!-- Shared metadata for all CertMaster projects. Bump Version for releases (installers read it from build/publish.ps1). -->
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Product>CertMaster</Product>
    <Company>CertMaster contributors</Company>
    <Copyright>Copyright (c) 2026 parthh37. MIT License.</Copyright>
    <Authors>parthh37</Authors>
    <RepositoryUrl>https://github.com/parthh37/certmaster</RepositoryUrl>
    <Deterministic>true</Deterministic>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
</Project>
