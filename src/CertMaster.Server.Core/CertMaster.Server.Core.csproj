  <ItemGroup>
    <!-- Start-up, logging and crash handling shared by the agent and hub services. -->
    <Compile Include="..\Shared\ServiceHosting.cs" Link="Shared\ServiceHosting.cs" />
    <Compile Include="..\Shared\ForeverRetryPolicy.cs" Link="Shared\ForeverRetryPolicy.cs" />
  </ItemGroup>

</Project>
