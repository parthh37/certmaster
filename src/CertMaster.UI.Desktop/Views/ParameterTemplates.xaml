<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:vm="clr-namespace:CertMaster.UI.Desktop.ViewModels"
                    xmlns:local="clr-namespace:CertMaster.UI.Desktop">

    <!-- Dynamic provider parameter editor: picks a control based on the parameter type. -->
    <DataTemplate DataType="{x:Type vm:ParameterViewModel}">
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource Cm.TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,6" />
            <ContentControl Content="{Binding}">
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Setter Property="ContentTemplate">
                            <Setter.Value>
                                <DataTemplate>
                                    <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="Password">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <PasswordBox local:PasswordHelper.BoundPassword="{Binding Value, Mode=TwoWay}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Boolean">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <mah:ToggleSwitch IsOn="{Binding BoolValue}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="Select">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding Options}" DisplayMemberPath="Value" SelectedValuePath="Key" SelectedValue="{Binding Value}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="MultiLineText">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="70" TextWrapping="Wrap" FontFamily="{StaticResource Cm.FontMono}" />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
            <TextBlock Text="{Binding Description}" Style="{StaticResource Cm.Caption}" Margin="0,4,0,0" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
