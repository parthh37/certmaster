<!--
    Windows 11 (Fluent) styles for the desktop app, layered over MahApps.Metro.
    Colors come from Themes/Light.xaml or Themes/Dark.xaml (keys "Cm.*"), which ThemeService merges at run time, so every
    color here is a DynamicResource. Type ramp: Caption 12, Body 14, Body Strong 14 semibold, Subtitle 20, Title 28.
    Corner radius: 4 for controls, 8 for cards and the content layer.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- ===================== Fonts ===================== -->
    <FontFamily x:Key="Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="Cm.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Cm.FontDisplay">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Cm.FontMono">Cascadia Mono, Consolas</FontFamily>

    <FontFamily x:Key="MahApps.Fonts.Family.Control">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Button">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Header">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Window.Title">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.ToggleSwitch">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.ToggleSwitch.Header">Segoe UI Variable Text, Segoe UI</FontFamily>
    <sys:Double x:Key="MahApps.Font.Size.Default">14</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Content">14</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Button">14</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.ToggleSwitch">14</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Window.Title">12</sys:Double>
    <sys:Double x:Key="MahApps.Font.Size.Tooltip">12</sys:Double>

    <CornerRadius x:Key="Cm.ControlRadius">4</CornerRadius>
    <CornerRadius x:Key="Cm.CardRadius">8</CornerRadius>

    <!-- ===================== Typography ===================== -->
    <Style x:Key="Cm.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cm.FontDisplay}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="Cm.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Cm.FontDisplay}" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
    </Style>
    <Style x:Key="Cm.BodyStrong" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
    </Style>
    <Style x:Key="Cm.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- Section heading inside a page (e.g. "Authorization") -->
    <Style x:Key="SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Cm.Subtitle}">
        <Setter Property="Margin" Value="0,4,0,4" />
    </Style>
    <!-- Group heading inside a card or above a list (e.g. "Deployment Tasks") -->
    <Style x:Key="GroupTitle" TargetType="TextBlock" BasedOn="{StaticResource Cm.BodyStrong}">
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,12,0,6" />
    </Style>
    <Style x:Key="Cm.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <!-- Icon in front of a button label -->
    <Style x:Key="Cm.ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Cm.Glyph}">
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!-- ===================== Surfaces ===================== -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cm.CardBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="CornerRadius" Value="{StaticResource Cm.CardRadius}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <Style x:Key="Cm.DividerLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Cm.Divider}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>
    <!-- InfoBar (informational) -->
    <Style x:Key="Cm.InfoBar" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Cm.AccentSubtle}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.CardStroke}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="Padding" Value="14,8" />
    </Style>

    <!-- Status dot for certificate health -->
    <Style x:Key="Cm.HealthDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="Fill" Value="{DynamicResource Cm.Neutral}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Health}" Value="OK"><Setter Property="Fill" Value="{DynamicResource Cm.Success}" /></DataTrigger>
            <DataTrigger Binding="{Binding Health}" Value="Warning"><Setter Property="Fill" Value="{DynamicResource Cm.Caution}" /></DataTrigger>
            <DataTrigger Binding="{Binding Health}" Value="Error"><Setter Property="Fill" Value="{DynamicResource Cm.Critical}" /></DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Badge showing a request state: tinted pill with colored text -->
    <Style x:Key="Cm.StateBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource Cm.AccentSubtle}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Cm.AccentText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding State}" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Cm.SuccessBackground}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Cm.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Cm.CautionBackground}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Cm.Caution}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Cm.CriticalBackground}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Cm.Critical}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Cm.FocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-3" BorderThickness="2" CornerRadius="6" BorderBrush="{DynamicResource Cm.TextPrimary}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Window ===================== -->
    <Style x:Key="Cm.Window" TargetType="mah:MetroWindow">
        <Setter Property="Background" Value="{DynamicResource Cm.WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="FontFamily" Value="{StaticResource Cm.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="WindowTitleBrush" Value="{DynamicResource Cm.WindowBackground}" />
        <Setter Property="NonActiveWindowTitleBrush" Value="{DynamicResource Cm.WindowBackground}" />
        <Setter Property="TitleForeground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="OverrideDefaultWindowCommandsBrush" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="GlowBrush" Value="{DynamicResource Cm.WindowGlow}" />
        <Setter Property="NonActiveGlowBrush" Value="{DynamicResource Cm.WindowGlowInactive}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="TitleCharacterCasing" Value="Normal" />
        <Setter Property="TitleBarHeight" Value="40" />
        <Setter Property="ShowIconOnTitleBar" Value="True" />
        <Setter Property="IconTemplate">
            <Setter.Value>
                <DataTemplate>
                    <Image Source="{Binding}" Width="16" Height="16" Margin="14,0,2,0" RenderOptions.BitmapScalingMode="HighQuality" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="TitleTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Cm.TextPrimary}" FontFamily="{StaticResource Cm.Font}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <!-- Standard button: light fill, subtle elevation border. -->
    <Style x:Key="Cm.Button" TargetType="ButtonBase">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.ControlElevationBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12,5,12,6" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontFamily" Value="{StaticResource Cm.Font}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cm.FocusVisual}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" SnapsToDevicePixels="True">
                        <ContentPresenter Margin="{TemplateBinding Padding}" RecognizesAccessKey="True"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cm.ControlStroke}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Cm.ControlStroke}" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="Button" BasedOn="{StaticResource Cm.Button}" />
    <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource Cm.Button}" />

    <!-- Accent (primary) button -->
    <Style x:Key="PrimaryToolButton" TargetType="Button" BasedOn="{StaticResource Cm.Button}">
        <Setter Property="Background" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextOnAccent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.AccentElevationBorder}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.AccentFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.AccentFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextOnAccentSecondary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource Cm.AccentFillDisabled}" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextOnAccentDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Subtle button: no fill until hovered. Used in command bars. -->
    <Style x:Key="SubtleButton" TargetType="Button" BasedOn="{StaticResource Cm.Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="10,5,11,6" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.SubtleFillPressed}" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource Cm.TextDisabled}" />
                <Setter Property="BorderBrush" Value="Transparent" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <!-- Square icon-only subtle button -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource SubtleButton}">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Icons}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style TargetType="Hyperlink">
        <Setter Property="Foreground" Value="{DynamicResource Cm.AccentText}" />
        <Setter Property="TextDecorations" Value="None" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="TextDecorations" Value="Underline" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===================== Text input ===================== -->
    <Style x:Key="Cm.TextBox" TargetType="TextBox" BasedOn="{StaticResource MahApps.Styles.TextBox}">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource Cm.TextControlBorderFocused}" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="1,1,1,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.InputFillFocused}" />
            </Trigger>
            <Trigger Property="AcceptsReturn" Value="True">
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style TargetType="TextBox" BasedOn="{StaticResource Cm.TextBox}" />

    <Style TargetType="PasswordBox" BasedOn="{StaticResource MahApps.Styles.PasswordBox}">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource Cm.TextControlBorderFocused}" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="1,1,1,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillHover}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.InputFillFocused}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="mah:NumericUpDown">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource Cm.TextControlBorder}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource Cm.TextControlBorderFocused}" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="1,1,1,2" />
        <Setter Property="TextAlignment" Value="Left" />
        <Setter Property="Padding" Value="6,4,6,4" />
    </Style>

    <Style TargetType="ComboBox" BasedOn="{StaticResource MahApps.Styles.ComboBox}">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.ControlElevationBorder}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="6,4,6,4" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{StaticResource Cm.ControlRadius}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource Cm.ControlElevationBorder}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource Cm.TextControlBorderFocused}" />
        <Setter Property="mah:ControlsHelper.FocusBorderThickness" Value="1,1,1,2" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Cm.ControlFillHover}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource MahApps.Styles.ComboBoxItem}">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Padding" Value="11,7" />
        <Setter Property="Margin" Value="4,1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Cm.ControlRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" Background="{DynamicResource Cm.AccentFill}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillSelected}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Check boxes, radio buttons, toggles ===================== -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource MahApps.Styles.CheckBox}">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Padding" Value="8,0,0,0" />
        <Setter Property="mah:CheckBoxHelper.CheckCornerRadius" Value="4" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundFillUnchecked" Value="{DynamicResource Cm.ControlFill}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundFillUncheckedMouseOver" Value="{DynamicResource Cm.ControlFillHover}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundStrokeUnchecked" Value="{DynamicResource Cm.ControlStrokeStrong}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundStrokeUncheckedMouseOver" Value="{DynamicResource Cm.ControlStrokeStrong}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundFillChecked" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundFillCheckedMouseOver" Value="{DynamicResource Cm.AccentFillHover}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundFillCheckedPressed" Value="{DynamicResource Cm.AccentFillPressed}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundStrokeChecked" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundStrokeCheckedMouseOver" Value="{DynamicResource Cm.AccentFillHover}" />
        <Setter Property="mah:CheckBoxHelper.CheckBackgroundStrokeCheckedPressed" Value="{DynamicResource Cm.AccentFillPressed}" />
        <Setter Property="mah:CheckBoxHelper.CheckGlyphForegroundChecked" Value="{DynamicResource Cm.TextOnAccent}" />
        <Setter Property="mah:CheckBoxHelper.CheckGlyphForegroundCheckedMouseOver" Value="{DynamicResource Cm.TextOnAccent}" />
        <Setter Property="mah:CheckBoxHelper.CheckGlyphForegroundCheckedPressed" Value="{DynamicResource Cm.TextOnAccentSecondary}" />
        <Setter Property="mah:CheckBoxHelper.ForegroundChecked" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="mah:CheckBoxHelper.ForegroundCheckedMouseOver" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="mah:CheckBoxHelper.ForegroundUnchecked" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="mah:CheckBoxHelper.ForegroundUncheckedMouseOver" Value="{DynamicResource Cm.TextPrimary}" />
    </Style>
    <Style TargetType="RadioButton" BasedOn="{StaticResource MahApps.Styles.RadioButton}">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style TargetType="mah:ToggleSwitch">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- ===================== Lists ===================== -->
    <!-- Fluent list item: rounded hover/selection fill with an accent pill on the selected item. -->
    <Style x:Key="Cm.ListItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cm.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Cm.ControlRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Border x:Name="Pill" Width="3" Height="16" CornerRadius="1.5" HorizontalAlignment="Left" VerticalAlignment="Center"
                                    Background="{DynamicResource Cm.AccentFill}" Visibility="Collapsed" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillSelected}" />
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillPressed}" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Cm.ListBox" TargetType="ListBox" BasedOn="{StaticResource MahApps.Styles.ListBox}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Cm.ListItem}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!-- Navigation pane item (left rail). Content is an icon + label. -->
    <Style x:Key="Cm.NavItem" TargetType="ListBoxItem" BasedOn="{StaticResource Cm.ListItem}">
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Margin" Value="0,2" />
        <Setter Property="AutomationProperties.ItemType" Value="Navigation item" />
    </Style>

    <!-- ===================== Selector bar (horizontal sections) ===================== -->
    <!-- RadioButton shown as a SelectorBar item: label with an accent pill below the selected one. -->
    <Style x:Key="NavButton" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cm.FocusVisual}" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Cm.ControlRadius}" Padding="12,8,12,10" SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" />
                            <Border x:Name="Pill" Height="3" Width="16" CornerRadius="1.5" Background="{DynamicResource Cm.AccentFill}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-9" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Tab controls ===================== -->
    <!-- Content-only tab control: the navigation pane picks the tab, so headers are hidden. -->
    <Style x:Key="Cm.PageHost" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="ItemContainerStyle">
            <Setter.Value>
                <Style TargetType="TabItem">
                    <Setter Property="Visibility" Value="Collapsed" />
                </Style>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pivot / SelectorBar style tabs (top), used inside Settings. -->
    <Style x:Key="Cm.PivotTabItem" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cm.FocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="Transparent" CornerRadius="{StaticResource Cm.ControlRadius}" Padding="12,8,12,10" Margin="0,0,4,0" SnapsToDevicePixels="True">
                        <Grid>
                            <ContentPresenter ContentSource="Header" TextElement.Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                            <Border x:Name="Pill" Height="3" Width="16" CornerRadius="1.5" Background="{DynamicResource Cm.AccentFill}"
                                    VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-9" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Cm.PivotTabControl" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Cm.PivotTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" IsItemsHost="True" KeyboardNavigation.TabNavigation="Once" Margin="-12,0,0,0" />
                        <Border DockPanel.Dock="Top" Style="{StaticResource Cm.DividerLine}" Margin="0,8,0,0" />
                        <ContentPresenter ContentSource="SelectedContent" Margin="{TemplateBinding Padding}" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Expanders ===================== -->
    <Style x:Key="Cm.ExpanderHeader" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource Cm.FocusVisual}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}" CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}" SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                            <ContentPresenter VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                            <Border x:Name="Chevron" Grid.Column="1" Width="32" Height="32" CornerRadius="4" Margin="8,-6,-6,-6">
                                <TextBlock x:Name="Glyph" FontFamily="{StaticResource Icons}" Text="&#xE70D;" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Cm.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform><RotateTransform x:Name="Rot" Angle="0" /></TextBlock.RenderTransform>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chevron" Property="Background" Value="{DynamicResource Cm.SubtleFillHover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Glyph" Property="RenderTransform">
                                <Setter.Value><RotateTransform Angle="180" /></Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Card expander (WinUI SettingsExpander look): used for configured tasks. -->
    <Style x:Key="Cm.CardExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{DynamicResource Cm.CardBackground}" BorderBrush="{DynamicResource Cm.CardStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource Cm.CardRadius}" SnapsToDevicePixels="True">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Style="{StaticResource Cm.ExpanderHeader}" Padding="16,13"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                            <Border x:Name="Body" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Cm.Divider}" Padding="16,4,16,16" Visibility="Collapsed">
                                <ContentPresenter />
                            </Border>
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain expander: header text with a chevron, no chrome. -->
    <Style TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <DockPanel>
                        <ToggleButton DockPanel.Dock="Top" Style="{StaticResource Cm.ExpanderHeader}" Padding="0,6" HorizontalAlignment="Left"
                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                      Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}" />
                        <ContentPresenter x:Name="Body" Margin="0,4,0,0" Visibility="Collapsed" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Data grid ===================== -->
    <Style x:Key="Cm.DataGridColumnHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource MahApps.Styles.DataGridColumnHeader}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="BorderBrush" Value="{DynamicResource Cm.Divider}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal" />
    </Style>
    <Style x:Key="Cm.DataGridCell" TargetType="DataGridCell" BasedOn="{StaticResource MahApps.Styles.DataGridCell}">
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
    </Style>
    <Style TargetType="DataGrid" BasedOn="{StaticResource MahApps.Styles.DataGrid}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="GridLinesVisibility" Value="Horizontal" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource Cm.Divider}" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="RowHeight" Value="36" />
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource Cm.DataGridColumnHeader}" />
        <Setter Property="CellStyle" Value="{StaticResource Cm.DataGridCell}" />
    </Style>

    <!-- ===================== Misc ===================== -->
    <Style TargetType="ToolTip">
        <Setter Property="Foreground" Value="{DynamicResource Cm.TextPrimary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{DynamicResource Cm.FlyoutBackground}" BorderBrush="{DynamicResource Cm.FlyoutStroke}" BorderThickness="1"
                            CornerRadius="{StaticResource Cm.ControlRadius}" Padding="9,6,9,8" MaxWidth="320">
                        <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter.Resources>
                                <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Background="{DynamicResource Cm.Divider}" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Thin scroll bars: a slim rounded thumb that widens on hover, no track or arrows (Windows 11). -->
    <Style x:Key="Cm.ScrollPage" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Cm.ScrollThumb" TargetType="Thumb">
        <Setter Property="Background" Value="{DynamicResource Cm.ControlStrokeStrong}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb"><Border Background="{TemplateBinding Background}" CornerRadius="3" /></ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Cm.ScrollPage}" Command="ScrollBar.PageUpCommand" /></Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Cm.ScrollPage}" Command="ScrollBar.PageDownCommand" /></Track.IncreaseRepeatButton>
                            <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource Cm.ScrollThumb}" Width="3" HorizontalAlignment="Center" /></Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Thumb" Property="Width" Value="6" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="12" />
                <Setter Property="MinHeight" Value="12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False">
                                    <Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource Cm.ScrollPage}" Command="ScrollBar.PageLeftCommand" /></Track.DecreaseRepeatButton>
                                    <Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource Cm.ScrollPage}" Command="ScrollBar.PageRightCommand" /></Track.IncreaseRepeatButton>
                                    <Track.Thumb><Thumb x:Name="Thumb" Style="{StaticResource Cm.ScrollThumb}" Height="3" VerticalAlignment="Center" /></Track.Thumb>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Thumb" Property="Height" Value="6" /></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="mah:ProgressRing">
        <Setter Property="Foreground" Value="{DynamicResource Cm.AccentFill}" />
    </Style>
    <Style TargetType="mah:MetroProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource Cm.AccentFill}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
</ResourceDictionary>
