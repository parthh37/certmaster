<UserControl x:Class="CertMaster.UI.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">
    <DockPanel Margin="4">
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,6,0,0" TextWrapping="Wrap" />
        <TabControl TabStripPlacement="Left" mah:HeaderedControlHelper.HeaderFontSize="15">
            <!-- General -->
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,4" MaxWidth="620" HorizontalAlignment="Left" DataContext="{Binding Preferences}">
                        <TextBlock Text="Renewals" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="Renew when this many days remain before expiry (short-lived certificates renew at one third of their lifetime)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                        <mah:NumericUpDown Value="{Binding RenewalIntervalDays}" Minimum="1" Maximum="60" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="Check for renewals every (minutes)" Style="{StaticResource FieldLabel}" />
                        <mah:NumericUpDown Value="{Binding RenewalCheckIntervalMinutes}" Minimum="5" Maximum="1440" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="Maximum renewals per run (0 = unlimited)" Style="{StaticResource FieldLabel}" />
                        <mah:NumericUpDown Value="{Binding MaxRenewalRequests}" Minimum="0" Maximum="1000" Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="HTTP Challenge Server" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                        <mah:ToggleSwitch Content="Enable built-in HTTP challenge server (http-01)" IsOn="{Binding EnableHttpChallengeServer}" />
                        <TextBlock Text="Listener prefix (http.sys URL; shares port 80 with IIS)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding HttpChallengeServerPrefix}" />
                        <TextBlock Text="Storage" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                        <TextBlock Text="Certificate store folder" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding CertificateStorePath}" />
                        <TextBlock Text="Default key type for new certificates" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding DefaultKeyType}" Width="160" HorizontalAlignment="Left" />
                        <Button Content="Save Settings" Margin="0,16,0,0" Style="{StaticResource PrimaryToolButton}" HorizontalAlignment="Left"
                                Command="{Binding DataContext.Settings.SavePreferencesCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- Certificate Authorities -->
            <TabItem Header="Certificate Authorities">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid Margin="16,4">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="ACME Accounts" Style="{StaticResource SectionTitle}" />
                            <DataGrid ItemsSource="{Binding Accounts}" AutoGenerateColumns="False" IsReadOnly="True" MinHeight="120">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="CA" Binding="{Binding CertificateAuthorityId}" />
                                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" />
                                    <DataGridCheckBoxColumn Header="Staging" Binding="{Binding IsStagingAccount}" />
                                    <DataGridTemplateColumn>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate><Button Content="Remove" Command="{Binding DataContext.Settings.RemoveAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock Text="Custom ACME CA" Style="{StaticResource SectionTitle}" Margin="0,16,0,4" />
                            <TextBlock Text="Add any ACME (RFC 8555) CA, e.g. an internal step-ca or a commercial ACME endpoint." Style="{StaticResource Hint}" />
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomCaTitle}" />
                            <TextBlock Text="Production directory URL" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomCaDirectory}" mah:TextBoxHelper.Watermark="https://ca.example.com/acme/directory" />
                            <TextBlock Text="Staging directory URL (optional)" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CustomCaStaging}" />
                            <CheckBox Content="Allow untrusted TLS certificate on the ACME endpoint (test/internal CAs only)" IsChecked="{Binding CustomCaUntrustedTls}" Margin="0,8" />
                            <Button Content="Add Custom CA" Style="{StaticResource ToolButton}" HorizontalAlignment="Left" Command="{Binding AddCustomCaCommand}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Register ACME Account" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Certificate Authority" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding Authorities}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedAuthority}" />
                            <TextBlock Text="{Binding SelectedAuthority.Description}" Style="{StaticResource Hint}" Margin="0,4,0,4" />
                            <TextBlock Text="Email address" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding AccountEmail}" />
                            <mah:ToggleSwitch Content="Staging (test) account" IsOn="{Binding AccountStaging}" Margin="0,6,0,0" />
                            <StackPanel Visibility="{Binding SelectedAuthority.RequiresExternalAccountBinding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding SelectedAuthority.EabInstructions}" Style="{StaticResource Hint}" Margin="0,6,0,0" />
                                <TextBlock Text="EAB Key Id" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EabKeyId}" />
                                <TextBlock Text="EAB HMAC Key" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding EabKey}" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding AccountAgree}" Content="I agree to the CA's terms and conditions" Margin="0,10" />
                            <Button Content="Register Account" Command="{Binding AddAccountCommand}" Style="{StaticResource PrimaryToolButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </TabItem>

            <!-- Stored Credentials -->
            <TabItem Header="Stored Credentials">
                <Grid Margin="16,4">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="Stored Credentials" Style="{StaticResource SectionTitle}" />
                        <TextBlock DockPanel.Dock="Top" Text="API keys and passwords used by DNS providers and tasks. Encrypted with Windows DPAPI on this machine and never shown again." Style="{StaticResource Hint}" />
                        <DataGrid ItemsSource="{Binding Credentials}" AutoGenerateColumns="False" IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
                                <DataGridTextColumn Header="Type" Binding="{Binding ProviderType}" />
                                <DataGridTextColumn Header="Created" Binding="{Binding DateCreated, StringFormat=d}" />
                                <DataGridTemplateColumn>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate><Button Content="Delete" Command="{Binding DataContext.Settings.DeleteCredentialCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" /></DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Add Credential" Style="{StaticResource SectionTitle}" />
                            <TextBlock Text="Type" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding CredentialTypes}" DisplayMemberPath="Title" SelectedItem="{Binding SelectedCredentialType}" IsTextSearchEnabled="True" />
                            <TextBlock Text="Title" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding CredentialTitle}" Margin="0,0,0,8" />
                            <ItemsControl ItemsSource="{Binding CredentialFields}" />
                            <Button Content="Save Credential" Command="{Binding AddCredentialCommand}" Style="{StaticResource PrimaryToolButton}" HorizontalAlignment="Left" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- Management Hub -->
            <TabItem Header="Management Hub">
                <StackPanel Margin="16,4" MaxWidth="600" HorizontalAlignment="Left">
                    <TextBlock Text="Management Hub" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Join this server to a CertMaster Management Hub to manage its certificates centrally. The agent connects outbound to the hub; no inbound port is needed." Style="{StaticResource Hint}" />
                    <TextBlock Text="Status" Style="{StaticResource FieldLabel}" />
                    <TextBlock Text="{Binding HubStatus}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <TextBlock Text="Hub URL" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding HubUrl}" mah:TextBoxHelper.Watermark="https://hub.example.com" />
                    <TextBlock Text="Joining key" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding JoiningKey}" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Join Hub" Command="{Binding JoinHubCommand}" Style="{StaticResource PrimaryToolButton}" />
                        <Button Content="Leave Hub" Command="{Binding LeaveHubCommand}" Style="{StaticResource ToolButton}" />
                        <Button Content="Refresh" Command="{Binding RefreshHubCommand}" Style="{StaticResource ToolButton}" />
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
