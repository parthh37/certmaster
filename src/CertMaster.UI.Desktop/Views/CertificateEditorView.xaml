<UserControl x:Class="CertMaster.UI.Desktop.Views.CertificateEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:CertMaster.UI.Desktop.ViewModels">
    <UserControl.Resources>
        <!-- Shared template for pre-request and deployment task lists -->
        <DataTemplate x:Key="TaskTemplate" DataType="{x:Type vm:DeploymentTaskViewModel}">
            <Expander Style="{StaticResource Cm.CardExpander}" IsExpanded="False">
                <Expander.Header>
                    <DockPanel>
                        <TextBlock Style="{StaticResource Cm.Glyph}" Text="&#xE9F5;" Foreground="{DynamicResource Cm.TextSecondary}" Margin="0,0,14,0" />
                        <StackPanel>
                            <TextBlock Text="{Binding TaskName}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding TypeTitle}" Style="{StaticResource Cm.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Expander.Header>
                <StackPanel>
                    <TextBlock Text="{Binding Definition.Description}" Style="{StaticResource Hint}" Margin="0,12,0,0" />
                    <UniformGrid Columns="2">
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Task name" Style="{StaticResource FieldLabel}" />
                            <TextBox Text="{Binding TaskName}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Trigger" Style="{StaticResource FieldLabel}" />
                            <ComboBox ItemsSource="{Binding TriggerOptions}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Trigger}" />
                        </StackPanel>
                    </UniformGrid>
                    <StackPanel Visibility="{Binding HasTargetChoice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Target" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding TargetOptions}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding TargetType}" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSsh, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Remote host (host or host:port)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding TargetHost}" mah:TextBoxHelper.Watermark="server.example.com:22" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding NeedsCredential, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Credentials" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding Credentials}" DisplayMemberPath="Title" SelectedValuePath="StorageKey" SelectedValue="{Binding CredentialKey}"
                                  mah:TextBoxHelper.Watermark="Select stored credential (add in Settings)" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,12,0,0" />
                    <WrapPanel Margin="0,4,0,0">
                        <mah:ToggleSwitch Content="Stop remaining tasks if this fails" IsOn="{Binding IsFatalOnError}" Margin="0,0,24,0" />
                        <mah:ToggleSwitch Content="Run even if a previous task failed" IsOn="{Binding RunIfLastStepFailed}" />
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <TextBlock Text="Retries" VerticalAlignment="Center" Margin="0,0,12,0" />
                        <mah:NumericUpDown Value="{Binding RetriesAllowed}" Minimum="0" Maximum="10" Width="110" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastResult}" Style="{StaticResource Hint}" Margin="0,12,0,0" Visibility="{Binding LastResult, Converter={StaticResource NullCollapsed}}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Command="{Binding DataContext.RunTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE768;" FontSize="14" /><TextBlock Text="Run now" /></StackPanel>
                        </Button>
                        <Button Command="{Binding DataContext.Editor.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE74D;" FontSize="14" /><TextBlock Text="Remove" /></StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Expander>
        </DataTemplate>

        <!-- Label column + field column inside a card -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,6,16,6" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- Header -->
        <StackPanel DockPanel.Dock="Top" Margin="24,20,24,0">
            <TextBlock Text="{Binding Heading}" Style="{StaticResource Cm.Title}" />
            <TextBlock Text="{Binding Summary}" Style="{StaticResource Hint}" Margin="0,2,0,12" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />

            <!-- Command bar -->
            <DockPanel Margin="-10,0,0,8">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Check the configuration without requesting a certificate" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE73E;" FontSize="14" /><TextBlock Text="Test" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryToolButton}" Command="{Binding DataContext.RequestCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE768;" FontSize="14" /><TextBlock Text="Request certificate" /></StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Save changes">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE74E;" /><TextBlock Text="Save" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.DiscardCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Discard unsaved changes">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE7A7;" /><TextBlock Text="Discard" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Export the current certificate">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xEDE1;" /><TextBlock Text="Export" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Revoke the current certificate with the CA">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE8F8;" /><TextBlock Text="Revoke" /></StackPanel>
                    </Button>
                    <Button Style="{StaticResource SubtleButton}" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" ToolTip="Delete this managed certificate">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE74D;" /><TextBlock Text="Delete" /></StackPanel>
                    </Button>
                </WrapPanel>
            </DockPanel>

            <!-- Test results -->
            <ItemsControl ItemsSource="{Binding DataContext.TestResults, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0,2">
                            <TextBlock DockPanel.Dock="Left" FontSize="14" Margin="0,2,10,0" VerticalAlignment="Top">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Cm.Glyph}">
                                        <Setter Property="Text" Value="&#xE73E;" />
                                        <Setter Property="Foreground" Value="{DynamicResource Cm.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasError}" Value="True">
                                                <Setter Property="Text" Value="&#xE783;" />
                                                <Setter Property="Foreground" Value="{DynamicResource Cm.Critical}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource Cm.TextSecondary}" /></TextBlock>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Section selector -->
            <WrapPanel Margin="-12,0,0,0">
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Certificate section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Certificate, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xEB95;" FontSize="14" /><TextBlock Text="Certificate" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Authorization section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Authorization, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE8D7;" FontSize="14" /><TextBlock Text="Authorization" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Deployment section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Deployment, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE8B7;" FontSize="14" /><TextBlock Text="Deployment" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Tasks section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Tasks, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE9F5;" FontSize="14" /><TextBlock Text="Tasks" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Preview section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Preview, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE7B3;" FontSize="14" /><TextBlock Text="Preview" /></StackPanel>
                </RadioButton>
                <RadioButton Style="{StaticResource NavButton}" GroupName="nav" AutomationProperties.Name="Log section" IsChecked="{Binding Section, Converter={StaticResource Eq}, ConverterParameter=Log, Mode=TwoWay}">
                    <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE9F9;" FontSize="14" /><TextBlock Text="Log" /></StackPanel>
                </RadioButton>
            </WrapPanel>
            <Border Style="{StaticResource Cm.DividerLine}" Margin="0,8,0,0" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,20,12">
            <Grid MaxWidth="1100" HorizontalAlignment="Stretch">
                <!-- ===== Certificate ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Certificate}">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Domains" Style="{StaticResource GroupTitle}" />
                            <TextBlock Text="Choose the domains to include. Pick a website to load its hostnames, or add domains manually." Style="{StaticResource Hint}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="150" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Text="Name" Style="{StaticResource RowLabel}" />
                                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="Defaults to the primary domain" Margin="0,4" />
                                <TextBlock Grid.Row="1" Text="Website" Style="{StaticResource RowLabel}" />
                                <DockPanel Grid.Row="1" Grid.Column="1" Margin="0,4">
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ServerStatusText}" Style="{StaticResource Cm.Caption}" VerticalAlignment="Center" Margin="12,0,0,0" MaxWidth="260" />
                                    <ComboBox ItemsSource="{Binding Sites}" DisplayMemberPath="Name" SelectedValuePath="Id" SelectedValue="{Binding SelectedSiteId}"
                                              IsEnabled="{Binding IsIisAvailable}" mah:TextBoxHelper.Watermark="(optional) select an IIS site"
                                              SelectionChanged="OnSiteChanged" />
                                </DockPanel>
                                <TextBlock Grid.Row="2" Text="Add domains" Style="{StaticResource RowLabel}" />
                                <DockPanel Grid.Row="2" Grid.Column="1" Margin="0,4">
                                    <Button DockPanel.Dock="Right" Margin="8,0,0,0" Command="{Binding AddDomainsCommand}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE710;" FontSize="12" /><TextBlock Text="Add" /></StackPanel>
                                    </Button>
                                    <TextBox Text="{Binding AddDomainsText, UpdateSourceTrigger=PropertyChanged}" mah:TextBoxHelper.Watermark="www.example.com, example.com, *.example.com" />
                                </DockPanel>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Domains}" AutoGenerateColumns="False" CanUserAddRows="False" Margin="0,16,0,0" MinHeight="90">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Header="Include" Binding="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" Width="70" />
                                    <DataGridTextColumn Header="Domain" Binding="{Binding Domain}" Width="*" />
                                    <DataGridTemplateColumn Header="Primary" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <RadioButton IsChecked="{Binding IsPrimary, Mode=OneWay}" HorizontalAlignment="Center" GroupName="primary" AutomationProperties.Name="Primary domain"
                                                             Command="{Binding DataContext.Editor.SetPrimaryCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Note" Binding="{Binding Comment}" IsReadOnly="True" Width="180" />
                                    <DataGridTemplateColumn Width="52">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="&#xE711;" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="12" ToolTip="Remove" AutomationProperties.Name="Remove domain"
                                                        Command="{Binding DataContext.Editor.RemoveDomainCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Certificate authority" Style="{StaticResource GroupTitle}" />
                                <TextBlock Text="Certificate Authority" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                                <ComboBox ItemsSource="{Binding Authorities}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Item.CertificateAuthorityId}" />
                                <mah:ToggleSwitch Content="Use staging (test) environment" IsOn="{Binding Item.UseStagingMode}" Margin="0,12,0,0" />
                                <mah:ToggleSwitch Content="Include in automatic renewal" IsOn="{Binding Item.IncludeInAutoRenew}" />
                                <mah:ToggleSwitch Content="Send failure notifications" ToolTip="Uses the webhook URL from Settings &gt; General" IsOn="{Binding Config.EnableFailureNotifications}" />
                                <TextBlock Text="IP addresses (optional, one per line)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding IpText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="56" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Key and renewal" Style="{StaticResource GroupTitle}" />
                                <TextBlock Text="Key type" Style="{StaticResource FieldLabel}" Margin="0,8,0,6" />
                                <ComboBox ItemsSource="{Binding KeyTypes}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Config.CSRKeyAlg}" />
                                <mah:ToggleSwitch Content="Reuse private key on renewal" IsOn="{Binding Config.ReusePrivateKey}" Margin="0,12,0,0" />
                                <TextBlock Text="Preferred chain (issuer common name, optional)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Config.PreferredChain}" />
                                <TextBlock Text="ACME profile (optional, e.g. tlsserver, shortlived)" Style="{StaticResource FieldLabel}" />
                                <TextBox Text="{Binding Config.AcmeProfile}" />
                                <TextBlock Text="Renew N days before expiry (blank = default)" Style="{StaticResource FieldLabel}" />
                                <mah:NumericUpDown Value="{Binding Item.CustomRenewalDaysBeforeExpiry}" Minimum="1" Maximum="365" HorizontalAlignment="Left" Width="150" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Comments" Style="{StaticResource GroupTitle}" Margin="0,0,0,8" />
                            <TextBox Text="{Binding Item.Comments}" AcceptsReturn="True" MinHeight="56" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Authorization ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Authorization}">
                    <TextBlock Text="Authorization" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="How the CA verifies that you control each domain. http-01 suits public web servers on port 80; dns-01 is required for wildcards and works for internal hosts. Add more configurations with a domain match to use different methods for different domains." Style="{StaticResource Hint}" />
                    <ItemsControl ItemsSource="{Binding Challenges}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:ChallengeConfigViewModel}">
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <UniformGrid Columns="3">
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Challenge type" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding ChallengeTypeOptions}" SelectedItem="{Binding ChallengeType}" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="Provider" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding ProviderId}" IsTextSearchEnabled="True" />
                                            </StackPanel>
                                            <StackPanel Visibility="{Binding NeedsCredential, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="Credentials" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                                                <ComboBox ItemsSource="{Binding Credentials}" DisplayMemberPath="Title" SelectedValuePath="StorageKey" SelectedValue="{Binding CredentialKey}" />
                                            </StackPanel>
                                        </UniformGrid>
                                        <TextBlock Text="{Binding ProviderDescription}" Style="{StaticResource Cm.Caption}" Margin="0,8,0,0" />
                                        <TextBlock Text="Apply to domains (optional, comma separated; blank = all)" Style="{StaticResource FieldLabel}" />
                                        <TextBox Text="{Binding DomainMatch}" />
                                        <StackPanel Visibility="{Binding IsDns, Converter={StaticResource BoolToVis}}">
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="CNAME delegation rule" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding DelegationRule}" mah:TextBoxHelper.Watermark="*.example.com:*.auth.example.net" />
                                                </StackPanel>
                                                <StackPanel Margin="0,0,12,0">
                                                    <TextBlock Text="Propagation delay (seconds)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding PropagationDelay}" mah:TextBoxHelper.Watermark="provider default" />
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="DNS zone id (optional)" Style="{StaticResource FieldLabel}" />
                                                    <TextBox Text="{Binding ZoneId}" />
                                                </StackPanel>
                                            </UniformGrid>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,12,0,0" />
                                        <Button HorizontalAlignment="Right" Margin="0,4,0,0"
                                                Command="{Binding DataContext.Editor.RemoveChallengeCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE74D;" FontSize="14" /><TextBlock Text="Remove" /></StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button HorizontalAlignment="Left" Command="{Binding AddChallengeCommand}">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE710;" FontSize="14" /><TextBlock Text="Add authorization configuration" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===== Deployment ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Deployment}">
                    <TextBlock Text="Deployment" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Certificates can be applied to IIS bindings automatically, or you can deploy them yourself with tasks (see Tasks)." Style="{StaticResource Hint}" />
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Text="Deployment mode" Style="{StaticResource RowLabel}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DeploymentModes}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Config.DeploymentSiteOption}" HorizontalAlignment="Left" MinWidth="320" Margin="0,4" />
                            <TextBlock Grid.Row="1" Text="Binding add/update" Style="{StaticResource RowLabel}" />
                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding BindingOptions}" DisplayMemberPath="Title" SelectedValuePath="Value" SelectedValue="{Binding Config.DeploymentBindingOption}" HorizontalAlignment="Left" MinWidth="320" Margin="0,4" />
                            <TextBlock Grid.Row="2" Text="Matching any of" Style="{StaticResource RowLabel}" VerticalAlignment="Top" Margin="0,12,16,0" />
                            <StackPanel Grid.Row="2" Grid.Column="1" Margin="0,10,0,0">
                                <CheckBox Content="Existing binding hostname matches certificate domains" IsChecked="{Binding Config.DeploymentBindingMatchHostname}" Margin="0,3" />
                                <CheckBox Content="Binding hostname not specified (IP only or All Unassigned)" IsChecked="{Binding Config.DeploymentBindingBlankHostname}" Margin="0,3" />
                                <CheckBox Content="Existing binding uses the previous version of this certificate" IsChecked="{Binding Config.DeploymentBindingReplacePrevious}" Margin="0,3" />
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="IIS binding settings" Style="{StaticResource GroupTitle}" />
                            <TextBlock Text="When new https bindings need to be created, these settings are used." Style="{StaticResource Hint}" />
                            <RadioButton Content="Auto create/update IIS bindings (uses SNI)" IsChecked="{Binding UseSpecificBinding, Converter={StaticResource Not}}" Margin="0,3" GroupName="bindmode" />
                            <RadioButton Content="Use specific IP/Port bindings" IsChecked="{Binding UseSpecificBinding}" Margin="0,3" GroupName="bindmode" />
                            <StackPanel Orientation="Horizontal" Margin="28,8,0,0" Visibility="{Binding UseSpecificBinding, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="IP" VerticalAlignment="Center" Margin="0,0,8,0" />
                                <TextBox Text="{Binding Config.BindingIPAddress}" Width="160" mah:TextBoxHelper.Watermark="* = all unassigned" />
                                <TextBlock Text="Port" VerticalAlignment="Center" Margin="16,0,8,0" />
                                <TextBox Text="{Binding Config.BindingPort}" Width="80" />
                                <CheckBox Content="Use SNI" IsChecked="{Binding Config.BindingUseSNI}" Margin="16,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="PFX password" Style="{StaticResource GroupTitle}" />
                            <TextBlock Text="Optional. Protect the stored PFX file with a password from Settings > Stored credentials (type: Password)." Style="{StaticResource Hint}" />
                            <ComboBox ItemsSource="{Binding DataContext.Settings.Credentials, RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Title" SelectedValuePath="StorageKey"
                                      SelectedValue="{Binding Item.CertificatePasswordCredentialId}" HorizontalAlignment="Left" MinWidth="320" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ===== Tasks ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Tasks}">
                    <TextBlock Text="Tasks" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="Tasks run before or after each certificate request or renewal: export files, deploy to other services and servers, run scripts or call webhooks." Style="{StaticResource Hint}" />
                    <TextBlock Text="Deployment tasks" Style="{StaticResource GroupTitle}" Margin="0,4,0,2" />
                    <TextBlock Text="Run after the certificate is issued (or on failure, depending on the trigger)." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskTemplate}" />
                    <Button HorizontalAlignment="Left" Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="post">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE710;" FontSize="14" /><TextBlock Text="Add deployment task" /></StackPanel>
                    </Button>
                    <TextBlock Text="Pre-request tasks" Style="{StaticResource GroupTitle}" Margin="0,28,0,2" />
                    <TextBlock Text="Run before the certificate request starts, e.g. to open a firewall port or stop a service." Style="{StaticResource Hint}" Margin="0,0,0,8" />
                    <ItemsControl ItemsSource="{Binding PreRequestTasks}" ItemTemplate="{StaticResource TaskTemplate}" />
                    <Button HorizontalAlignment="Left" Command="{Binding DataContext.AddTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="pre">
                        <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE710;" FontSize="14" /><TextBlock Text="Add pre-request task" /></StackPanel>
                    </Button>
                </StackPanel>

                <!-- ===== Preview ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Preview}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" VerticalAlignment="Top" Command="{Binding DataContext.PreviewCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                            <StackPanel Orientation="Horizontal"><TextBlock Style="{StaticResource Cm.ButtonGlyph}" Text="&#xE72C;" FontSize="14" /><TextBlock Text="Refresh preview" /></StackPanel>
                        </Button>
                        <TextBlock Text="Preview" Style="{StaticResource SectionTitle}" />
                    </DockPanel>
                    <TextBlock Text="What will happen when this certificate is requested, based on the current (unsaved) settings. Nothing is changed." Style="{StaticResource Hint}" />
                    <ItemsControl ItemsSource="{Binding PreviewSteps}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,8">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Title}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Cm.BodyStrong}">
                                                    <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="{DynamicResource Cm.Critical}" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Description}" TextWrapping="Wrap" Foreground="{DynamicResource Cm.TextSecondary}" Margin="0,4,0,0" />
                                        <ItemsControl ItemsSource="{Binding Substeps}" Margin="4,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="0,2">
                                                        <Ellipse DockPanel.Dock="Left" Width="5" Height="5" Fill="{DynamicResource Cm.TextTertiary}" Margin="0,8,10,0" VerticalAlignment="Top" />
                                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  " /><Run Text="{Binding Description, Mode=OneWay}" Foreground="{DynamicResource Cm.TextSecondary}" /></TextBlock>
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- ===== Log ===== -->
                <StackPanel Visibility="{Binding Section, Converter={StaticResource EqVis}, ConverterParameter=Log}">
                    <TextBlock Text="Request log" Style="{StaticResource SectionTitle}" Margin="0,4,0,12" />
                    <Border Style="{StaticResource Card}" Padding="4">
                        <ListBox ItemsSource="{Binding DataContext.Log, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="{StaticResource Cm.FontMono}" FontSize="12"
                                 MaxHeight="520" MinHeight="120" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ItemContainerStyle="{StaticResource Cm.ListItem}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock TextWrapping="Wrap"><Run Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss, Mode=OneWay}" Foreground="{DynamicResource Cm.TextTertiary}" /><Run Text="  " /><Run Text="{Binding Level, Mode=OneWay}" Foreground="{DynamicResource Cm.TextSecondary}" /><Run Text="  " /><Run Text="{Binding Message, Mode=OneWay}" /></TextBlock>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
