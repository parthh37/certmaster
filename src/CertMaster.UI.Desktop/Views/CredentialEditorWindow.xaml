<mah:MetroWindow x:Class="CertMaster.UI.Desktop.Views.CredentialEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Style="{StaticResource Cm.Window}"
                 Title="Add credential" Height="560" Width="560" MinWidth="420" MinHeight="360" WindowStartupLocation="CenterOwner"
                 ShowMinButton="False" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="24,8,24,16">
                <TextBlock x:Name="Heading" Style="{StaticResource Cm.Subtitle}" TextWrapping="Wrap" />
                <TextBlock Text="Stored encrypted on the agent machine (Windows DPAPI). Secrets are never shown again; manage them later in Settings &gt; Stored credentials."
                           Style="{StaticResource Hint}" Margin="0,4,0,16" />
                <TextBlock Text="Title" Style="{StaticResource FieldLabel}" Margin="0,0,0,6" />
                <TextBox x:Name="TitleBox" Margin="0,0,0,12" AutomationProperties.Name="Credential title" />
                <ItemsControl x:Name="Fields" IsTabStop="False" />
                <TextBlock x:Name="Error" Foreground="{DynamicResource Cm.Critical}" TextWrapping="Wrap" Visibility="Collapsed" />
            </StackPanel>
        </ScrollViewer>
        <!-- Dialog footer -->
        <Border Grid.Row="1" Background="{DynamicResource Cm.LayerBackground}" BorderBrush="{DynamicResource Cm.Divider}" BorderThickness="0,1,0,0" Padding="24,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Save credential" Style="{StaticResource PrimaryToolButton}" IsDefault="True" MinWidth="130" Margin="0,0,8,0" Click="OnSave" />
                <Button Content="Cancel" IsCancel="True" MinWidth="110" />
            </StackPanel>
        </Border>
    </Grid>
</mah:MetroWindow>
