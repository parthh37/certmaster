<mah:MetroWindow x:Class="CertMaster.UI.Desktop.Views.TaskPickerWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 Style="{StaticResource Cm.Window}"
                 Title="Add task" Height="600" Width="660" MinWidth="460" MinHeight="360" WindowStartupLocation="CenterOwner"
                 ShowMinButton="False" ResizeMode="CanResizeWithGrip">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <DockPanel Margin="24,8,24,0">
            <TextBlock DockPanel.Dock="Top" Text="Choose a task" Style="{StaticResource Cm.Subtitle}" />
            <TextBlock DockPanel.Dock="Top" Text="Pick the type of task to add. You can configure it after adding." Style="{StaticResource Hint}" Margin="0,4,0,12" />
            <TextBox DockPanel.Dock="Top" x:Name="FilterBox" Margin="0,0,0,12" mah:TextBoxHelper.Watermark="Search tasks" mah:TextBoxHelper.ClearTextButton="{Binding (mah:TextBoxHelper.HasText), RelativeSource={RelativeSource Self}}"
                     AutomationProperties.Name="Search tasks" TextChanged="OnFilter" />
            <ListBox x:Name="List" Style="{StaticResource Cm.ListBox}" Margin="-12,0,-12,8" MouseDoubleClick="OnDoubleClick" AutomationProperties.Name="Task types">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="Add" Click="OnSelect" Tag="{Binding}" MinWidth="72" Margin="16,0,0,0" VerticalAlignment="Center" />
                            <StackPanel>
                                <TextBlock TextWrapping="Wrap">
                                    <Run Text="{Binding Title, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="{Binding UsageNote, Mode=OneWay}" Foreground="{DynamicResource Cm.Caution}" FontSize="12" />
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" Style="{StaticResource Cm.Caption}" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
        <!-- Dialog footer -->
        <Border Grid.Row="1" Background="{DynamicResource Cm.LayerBackground}" BorderBrush="{DynamicResource Cm.Divider}" BorderThickness="0,1,0,0" Padding="24,16">
            <Button Content="Cancel" IsCancel="True" MinWidth="110" HorizontalAlignment="Right" />
        </Border>
    </Grid>
</mah:MetroWindow>
