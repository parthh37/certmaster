<mah:MetroWindow x:Class="CertMaster.UI.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:vm="clr-namespace:CertMaster.UI.Desktop.ViewModels"
                 Title="CertMaster - Certificate Manager" Height="820" Width="1300" MinWidth="980" MinHeight="600"
                 WindowStartupLocation="CenterScreen" GlowBrush="{DynamicResource MahApps.Brushes.Accent}">

    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            <Button Content="Settings" Command="{Binding OpenSettingsCommand}" />
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>

    <DockPanel>
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock><Run Text="{Binding Version}" /><Run Text="  |  Agent: " /><Run Text="{Binding ConnectionState}" /></TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8">
            <Button Content="+ New Certificate" Command="{Binding NewCommand}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Padding="12,6" Margin="0,0,6,0" />
            <Button Content="Renew All Due" Command="{Binding RenewAllCommand}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="12,6" Margin="0,0,6,0" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="12,6" />
            <mah:ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="12,0" />
        </StackPanel>

        <Grid Margin="8,0,8,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Managed certificate list -->
            <DockPanel>
                <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Search..." mah:TextBoxHelper.ClearTextButton="True"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="2,4">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="8" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Rectangle Fill="{Binding Health, Converter={StaticResource HealthBrush}}" Margin="0,0,4,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Foreground="Gray" FontSize="11">
                                        <Run Text="Expires: " /><Run Text="{Binding DateExpiry, StringFormat=d, TargetNullValue=-}" />
                                        <Run Text="  |  " /><Run Text="{Binding Health}" />
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />

            <!-- Editor -->
            <Grid Grid.Column="2">
                <TextBlock Text="Select a managed certificate, or click New Certificate." Foreground="Gray" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers><DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <DockPanel DataContext="{Binding Editor}" Margin="8,0,0,0">
                    <DockPanel.Style>
                        <Style TargetType="DockPanel">
                            <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                        </Style>
                    </DockPanel.Style>

                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBox Text="{Binding Item.Name}" FontSize="18" MinWidth="320" mah:TextBoxHelper.Watermark="Name (defaults to primary domain)" />
                        <Button Content="Save" Command="{Binding DataContext.SaveCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square.Accent}" Padding="14,6" Margin="10,0,4,0" />
                        <Button Content="Test" Command="{Binding DataContext.TestCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="14,6" Margin="0,0,4,0" />
                        <Button Content="Request Certificate" Command="{Binding DataContext.RequestCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square.Highlight}" Padding="14,6" Margin="0,0,4,0" />
                        <Button Content="Export..." Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="10,6" Margin="0,0,4,0" />
                        <Button Content="Revoke" Command="{Binding DataContext.RevokeCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="10,6" Margin="0,0,4,0" />
                        <Button Content="Delete" Command="{Binding DataContext.DeleteCommand, RelativeSource={RelativeSource AncestorType=Window}}" Style="{DynamicResource MahApps.Styles.Button.Square}" Padding="10,6" />
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="Gray" Margin="0,0,0,6" TextTrimming="CharacterEllipsis" />

                    <!-- Test results -->
                    <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding DataContext.TestResults, RelativeSource={RelativeSource AncestorType=Window}}" Margin="0,0,0,6">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,1">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="SeaGreen" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasError}" Value="True"><Setter Property="Foreground" Value="Firebrick" /></DataTrigger></Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                    <Run Text="{Binding Title}" FontWeight="SemiBold" /><Run Text=": " /><Run Text="{Binding Description}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TabControl mah:HeaderedControlHelper.HeaderFontSize="16">
                        <!-- Certificate -->
                        <TabItem Header="Certificate">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <Grid Margin="4,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="20" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Domains (first is primary; one per line, wildcards allowed)" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding DomainsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="140" TextWrapping="Wrap" Margin="0,2,0,10" />
                                        <TextBlock Text="Comments" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Item.Comments}" AcceptsReturn="True" MinHeight="50" Margin="0,2,0,10" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Certificate Authority" FontWeight="SemiBold" />
                                        <ComboBox ItemsSource="{Binding Authorities}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding Item.CertificateAuthorityId}" Margin="0,2,0,10" />
                                        <mah:ToggleSwitch Header="Use staging (test) environment" IsOn="{Binding Item.UseStagingMode}" />
                                        <mah:ToggleSwitch Header="Auto renew" IsOn="{Binding Item.IncludeInAutoRenew}" />
                                        <TextBlock Text="Key type" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <ComboBox ItemsSource="{Binding KeyTypes}" SelectedItem="{Binding Item.RequestConfig.CSRKeyAlg}" Margin="0,2,0,10" />
                                        <mah:ToggleSwitch Header="Reuse private key on renewal" IsOn="{Binding Item.RequestConfig.ReusePrivateKey}" />
                                        <TextBlock Text="Preferred chain (optional)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                        <TextBox Text="{Binding Item.RequestConfig.PreferredChain}" Margin="0,2,0,10" />
                                        <TextBlock Text="Web root (for file based http-01, optional)" FontWeight="SemiBold" />
                                        <TextBox Text="{Binding Item.RequestConfig.WebsiteRootPath}" Margin="0,2,0,10" />
                                    </StackPanel>
                                </Grid>
                            </ScrollViewer>
                        </TabItem>

                        <!-- Authorization -->
                        <TabItem Header="Authorization">
                            <DockPanel Margin="4,10">
                                <Button DockPanel.Dock="Bottom" HorizontalAlignment="Left" Content="+ Add authorization config" Command="{Binding AddChallengeCommand}" Margin="0,6,0,0" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Challenges}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ChallengeConfigViewModel}">
                                                <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1" Padding="10" Margin="0,0,0,8">
                                                    <StackPanel>
                                                        <UniformGrid Columns="3">
                                                            <StackPanel Margin="0,0,8,0">
                                                                <TextBlock Text="Challenge type" FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding ChallengeTypeOptions}" SelectedItem="{Binding ChallengeType}" />
                                                            </StackPanel>
                                                            <StackPanel Margin="0,0,8,0">
                                                                <TextBlock Text="Provider" FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding Providers}" DisplayMemberPath="Title" SelectedValuePath="Id" SelectedValue="{Binding ProviderId}" />
                                                            </StackPanel>
                                                            <StackPanel Visibility="{Binding NeedsCredential, Converter={StaticResource BoolToVis}}">
                                                                <TextBlock Text="Credentials" FontWeight="SemiBold" />
                                                                <ComboBox ItemsSource="{Binding Credentials}" DisplayMemberPath="Title" SelectedValuePath="StorageKey" SelectedValue="{Binding CredentialKey}" />
                                                            </StackPanel>
                                                        </UniformGrid>
                                                        <TextBlock Text="Apply to domains (optional, comma separated)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                        <TextBox Text="{Binding DomainMatch}" />
                                                        <StackPanel Visibility="{Binding IsDns, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="CNAME delegation rule (optional) e.g. *.example.com:*.auth.example.net" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                            <TextBox Text="{Binding DelegationRule}" />
                                                            <TextBlock Text="Propagation delay seconds (blank = provider default)" FontWeight="SemiBold" Margin="0,8,0,0" />
                                                            <TextBox Text="{Binding PropagationDelay}" Width="120" HorizontalAlignment="Left" />
                                                        </StackPanel>
                                                        <ItemsControl ItemsSource="{Binding Parameters}" Margin="0,8,0,0" />
                                                        <Button Content="Remove" HorizontalAlignment="Right" Command="{Binding DataContext.RemoveChallengeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=2}}" CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <!-- Deployment tasks -->
                        <TabItem Header="Deployment Tasks">
                            <DockPanel Margin="4,10">
                                <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
                                    <ComboBox ItemsSource="{Binding DeploymentProviders}" DisplayMemberPath="Title" SelectedItem="{Binding NewTaskType}" MinWidth="280" mah:TextBoxHelper.Watermark="Choose a task type..." />
                                    <Button Content="+ Add Task" Command="{Binding AddTaskCommand}" Margin="6,0,0,0" />
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Tasks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DeploymentTaskViewModel}">
                                                <Expander Margin="0,0,0,6" IsExpanded="False">
                                                    <Expander.Header>
                                                        <TextBlock><Run Text="{Binding TaskName}" FontWeight="SemiBold" /><Run Text="  (" /><Run Text="{Binding TypeTitle}" /><Run Text=")" /></TextBlock>
                                                    </Expander.Header>
                                                    <StackPanel Margin="6">
                                                        <UniformGrid Columns="2">
                                                            <StackPanel Margin="0,0,8,0"><TextBlock Text="Task name" FontWeight="SemiBold" /><TextBox Text="{Binding TaskName}" /></StackPanel>
                                                            <StackPanel><TextBlock Text="Trigger" FontWeight="SemiBold" /><ComboBox ItemsSource="{Binding TriggerOptions}" SelectedItem="{Binding Trigger}" /></StackPanel>
                                                        </UniformGrid>
                                                        <mah:ToggleSwitch Header="Stop remaining tasks if this fails" IsOn="{Binding IsFatalOnError}" Margin="0,6" />
                                                        <StackPanel Visibility="{Binding NeedsCredential, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Credentials" FontWeight="SemiBold" />
                                                            <ComboBox ItemsSource="{Binding Credentials}" DisplayMemberPath="Title" SelectedValuePath="StorageKey" SelectedValue="{Binding CredentialKey}" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Definition.Description}" Foreground="Gray" TextWrapping="Wrap" Margin="0,4" />
                                                        <ItemsControl ItemsSource="{Binding Parameters}" />
                                                        <TextBlock Text="{Binding LastResult}" Foreground="Gray" TextWrapping="Wrap" />
                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                            <Button Content="Run now" Margin="0,0,6,0" Command="{Binding DataContext.RunTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" />
                                                            <Button Content="Remove" Command="{Binding DataContext.RemoveTaskCommand, RelativeSource={RelativeSource AncestorType=ItemsControl, AncestorLevel=1}}" CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </TabItem>

                        <!-- Status & log -->
                        <TabItem Header="Status &amp; Log">
                            <Grid Margin="4,10">
                                <Grid.RowDefinitions><RowDefinition Height="140" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                                <GroupBox Header="Live progress">
                                    <ListBox ItemsSource="{Binding DataContext.Progress, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas" />
                                </GroupBox>
                                <GroupBox Header="Request log" Grid.Row="1" Margin="0,6,0,0">
                                    <ListBox ItemsSource="{Binding DataContext.Log, RelativeSource={RelativeSource AncestorType=Window}}" FontFamily="Consolas">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock TextWrapping="Wrap"><Run Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="Gray" /><Run Text=" [" /><Run Text="{Binding Level}" /><Run Text="] " /><Run Text="{Binding Message}" /></TextBlock>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </GroupBox>
                            </Grid>
                        </TabItem>
                    </TabControl>
                </DockPanel>
            </Grid>
        </Grid>
    </DockPanel>
</mah:MetroWindow>
