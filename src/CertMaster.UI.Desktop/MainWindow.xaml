<mah:MetroWindow x:Class="CertMaster.UI.Desktop.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:views="clr-namespace:CertMaster.UI.Desktop.Views"
                 Title="{Binding Version, StringFormat={}{0} - Certificate Manager}" Height="840" Width="1320" MinWidth="1020" MinHeight="620"
                 WindowStartupLocation="CenterScreen" GlowBrush="{DynamicResource MahApps.Brushes.Accent}" TitleCharacterCasing="Normal">

    <DockPanel>
        <!-- Status bar -->
        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem Content="{Binding StatusText}" />
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock><Run Text="{Binding AgentVersion, Mode=OneWay}" /><Run Text="  |  Agent: " /><Run Text="{Binding ConnectionState, Mode=OneWay}" /></TextBlock>
            </StatusBarItem>
        </StatusBar>

        <!-- Main toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,10,10,4">
            <Button Style="{StaticResource ToolButton}" Command="{Binding NewCommand}" Padding="12,6">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE710;" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,2,8,0" FontSize="15" /><TextBlock Text="New Certificate" /></StackPanel>
            </Button>
            <Button Style="{StaticResource ToolButton}" Command="{Binding RenewAllCommand}" Padding="12,6">
                <StackPanel Orientation="Horizontal"><TextBlock FontFamily="{StaticResource Icons}" Text="&#xE895;" Foreground="{DynamicResource MahApps.Brushes.Accent}" Margin="0,2,8,0" FontSize="15" /><TextBlock Text="Renew All" /></StackPanel>
            </Button>
            <mah:ProgressRing IsActive="{Binding IsBusy}" Width="22" Height="22" Margin="12,0" />
        </StackPanel>

        <TabControl SelectedIndex="{Binding SelectedTab}" Margin="10,0,10,6" mah:HeaderedControlHelper.HeaderFontSize="14" mah:TabControlHelper.Underlined="SelectedTabItem">
            <!-- ===== Managed Certificates ===== -->
            <TabItem Header="Managed Certificates">
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300" MinWidth="220" />
                        <ColumnDefinition Width="6" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" mah:TextBoxHelper.Watermark="Filter..." mah:TextBoxHelper.ClearTextButton="True"
                                 Text="{Binding Search, UpdateSourceTrigger=PropertyChanged, Delay=300}" />
                        <ListBox ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem}" BorderThickness="1" BorderBrush="{DynamicResource MahApps.Brushes.Gray8}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="2,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="6" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Rectangle Fill="{Binding Health, Converter={StaticResource HealthBrush}}" Margin="0,0,6,0" />
                                        <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Foreground="Gray" FontSize="11">
                                                <Run Text="{Binding Health, Converter={StaticResource HealthText}, Mode=OneWay}" />
                                                <Run Text="  ·  expires " /><Run Text="{Binding DateExpiry, StringFormat=d, TargetNullValue=-, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                    <Grid Grid.Column="2" Margin="10,0,0,0">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers><DataTrigger Binding="{Binding Editor}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                </Style>
                            </StackPanel.Style>
                            <TextBlock FontFamily="{StaticResource Icons}" Text="&#xEB95;" FontSize="48" HorizontalAlignment="Center" Foreground="{DynamicResource MahApps.Brushes.Gray7}" />
                            <TextBlock Text="Select a managed certificate, or click New Certificate to get started." Foreground="Gray" FontSize="15" Margin="0,10,0,0" />
                        </StackPanel>
                        <views:CertificateEditorView DataContext="{Binding Editor}">
                            <views:CertificateEditorView.Style>
                                <Style TargetType="views:CertificateEditorView">
                                    <Style.Triggers><DataTrigger Binding="{Binding}" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                </Style>
                            </views:CertificateEditorView.Style>
                        </views:CertificateEditorView>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===== In Progress ===== -->
            <TabItem>
                <TabItem.Header>
                    <TextBlock><Run Text="In Progress" /><Run Text="{Binding RunningCount, StringFormat={} ({0}), Mode=OneWay}" /></TextBlock>
                </TabItem.Header>
                <DockPanel Margin="0,8,0,0">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Certificate requests running now or completed during this session." Style="{StaticResource Hint}" Margin="0,4,12,0" />
                        <Button Content="Clear finished" Style="{StaticResource ToolButton}" Command="{Binding ClearFinishedCommand}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding InProgress}">
                        <ItemsControl.Template>
                            <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Card}" BorderThickness="4,1,1,1" BorderBrush="{Binding State, Converter={StaticResource StateBrush}}">
                                    <StackPanel>
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Text="{Binding State}" Foreground="{Binding State, Converter={StaticResource StateBrush}}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,4" />
                                        <mah:MetroProgressBar IsIndeterminate="True" Height="4">
                                            <mah:MetroProgressBar.Style>
                                                <Style TargetType="mah:MetroProgressBar">
                                                    <Style.Triggers><DataTrigger Binding="{Binding IsFinal}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </mah:MetroProgressBar.Style>
                                        </mah:MetroProgressBar>
                                        <Expander Header="Details" Margin="0,4,0,0">
                                            <ItemsControl ItemsSource="{Binding Messages}" FontFamily="Consolas" />
                                        </Expander>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </TabItem>

            <!-- ===== Settings ===== -->
            <TabItem Header="Settings">
                <views:SettingsView DataContext="{Binding Settings}" Margin="0,8,0,0" />
            </TabItem>

            <!-- ===== About ===== -->
            <TabItem Header="About">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10,16" MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="CertMaster" FontSize="28" FontWeight="Light" />
                        <TextBlock Text="{Binding AppVersion, StringFormat=Version {0}}" Margin="0,2,0,0" />
                        <TextBlock Text="{Binding AgentVersion}" Style="{StaticResource Hint}" />
                        <TextBlock TextWrapping="Wrap" Margin="0,10">
                            Open-source ACME certificate manager for Windows: requests, renews and deploys TLS certificates from Let's Encrypt and other
                            ACME certificate authorities, with automatic IIS binding, dozens of DNS providers and deployment tasks, and optional central
                            management through the CertMaster Management Hub.
                        </TextBlock>
                        <TextBlock Text="License" Style="{StaticResource SectionTitle}" />
                        <TextBlock Text="MIT License. Free for personal and commercial use; no license key or evaluation limits." TextWrapping="Wrap" />
                        <TextBlock Text="Third-party components" Style="{StaticResource SectionTitle}" Margin="0,12,0,4" />
                        <TextBlock TextWrapping="Wrap">
                            Certes (MIT), BouncyCastle (MIT), MahApps.Metro (MIT), CommunityToolkit.Mvvm (MIT), MudBlazor (MIT), Serilog (Apache-2.0),
                            SSH.NET (MIT), DnsClient (Apache-2.0), AWS SDK for .NET (Apache-2.0), Azure SDK for .NET (MIT), Posh-ACME (MIT), Microsoft .NET (MIT).
                        </TextBlock>
                        <TextBlock Margin="0,12,0,0">
                            <Hyperlink NavigateUri="https://github.com/parthh37/certmaster" RequestNavigate="OnNavigate">github.com/parthh37/certmaster</Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</mah:MetroWindow>
