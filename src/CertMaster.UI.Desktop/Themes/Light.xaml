<!--
    Windows 11 (Fluent) light theme tokens. Values follow the WinUI 3 light palette, flattened to solid colors where
    WPF has no backdrop (Mica) to blend against. Accent brushes are added by ThemeService from the Windows accent color.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Cm.WindowBackground" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Cm.LayerBackground" Color="#F9F9F9" />
    <SolidColorBrush x:Key="Cm.LayerStroke" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Cm.CardBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Cm.CardBackgroundSecondary" Color="#F7F7F7" />
    <SolidColorBrush x:Key="Cm.CardStroke" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Cm.Divider" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Cm.FlyoutBackground" Color="#FCFCFC" />
    <SolidColorBrush x:Key="Cm.FlyoutStroke" Color="#D9D9D9" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Cm.ControlFill" Color="#FBFBFB" />
    <SolidColorBrush x:Key="Cm.ControlFillHover" Color="#F6F6F6" />
    <SolidColorBrush x:Key="Cm.ControlFillPressed" Color="#F3F3F3" />
    <SolidColorBrush x:Key="Cm.ControlFillDisabled" Color="#F5F5F5" />
    <SolidColorBrush x:Key="Cm.InputFillFocused" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Cm.ControlStroke" Color="#E5E5E5" />
    <SolidColorBrush x:Key="Cm.ControlStrokeStrong" Color="#868686" />
    <SolidColorBrush x:Key="Cm.SubtleFillHover" Color="#0A000000" />
    <SolidColorBrush x:Key="Cm.SubtleFillPressed" Color="#06000000" />
    <SolidColorBrush x:Key="Cm.SubtleFillSelected" Color="#0A000000" />

    <!-- Button border: a slightly darker bottom edge gives the Fluent "elevation" look. -->
    <LinearGradientBrush x:Key="Cm.ControlElevationBorder" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="#D1D1D1" />
        <GradientStop Offset="1.0" Color="#E5E5E5" />
    </LinearGradientBrush>
    <!-- Text input border: thin neutral outline with a stronger bottom line, as in WinUI TextBox. -->
    <LinearGradientBrush x:Key="Cm.TextControlBorder" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#868686" />
        <GradientStop Offset="0.5" Color="#E5E5E5" />
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="Cm.TextPrimary" Color="#1B1B1B" />
    <SolidColorBrush x:Key="Cm.TextSecondary" Color="#616161" />
    <SolidColorBrush x:Key="Cm.TextTertiary" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Cm.TextDisabled" Color="#A0A0A0" />

    <!-- Status -->
    <SolidColorBrush x:Key="Cm.Success" Color="#0F7B0F" />
    <SolidColorBrush x:Key="Cm.Caution" Color="#9D5D00" />
    <SolidColorBrush x:Key="Cm.Critical" Color="#C42B1C" />
    <SolidColorBrush x:Key="Cm.Neutral" Color="#8A8A8A" />
    <SolidColorBrush x:Key="Cm.SuccessBackground" Color="#DFF6DD" />
    <SolidColorBrush x:Key="Cm.CautionBackground" Color="#FFF4CE" />
    <SolidColorBrush x:Key="Cm.CriticalBackground" Color="#FDE7E9" />
    <SolidColorBrush x:Key="Cm.NeutralBackground" Color="#F0F0F0" />

    <Color x:Key="Cm.WindowGlowColor">#59000000</Color>
    <SolidColorBrush x:Key="Cm.WindowGlow" Color="#59000000" />
    <SolidColorBrush x:Key="Cm.WindowGlowInactive" Color="#33000000" />
</ResourceDictionary>
