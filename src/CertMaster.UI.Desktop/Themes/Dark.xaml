<!--
    Windows 11 (Fluent) dark theme tokens. Same keys as Light.xaml; see that file for notes.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="Cm.WindowBackground" Color="#202020" />
    <SolidColorBrush x:Key="Cm.LayerBackground" Color="#272727" />
    <SolidColorBrush x:Key="Cm.LayerStroke" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Cm.CardBackground" Color="#2D2D2D" />
    <SolidColorBrush x:Key="Cm.CardBackgroundSecondary" Color="#292929" />
    <SolidColorBrush x:Key="Cm.CardStroke" Color="#1C1C1C" />
    <SolidColorBrush x:Key="Cm.Divider" Color="#3A3A3A" />
    <SolidColorBrush x:Key="Cm.FlyoutBackground" Color="#2C2C2C" />
    <SolidColorBrush x:Key="Cm.FlyoutStroke" Color="#1A1A1A" />

    <!-- Controls -->
    <SolidColorBrush x:Key="Cm.ControlFill" Color="#373737" />
    <SolidColorBrush x:Key="Cm.ControlFillHover" Color="#3D3D3D" />
    <SolidColorBrush x:Key="Cm.ControlFillPressed" Color="#323232" />
    <SolidColorBrush x:Key="Cm.ControlFillDisabled" Color="#2F2F2F" />
    <SolidColorBrush x:Key="Cm.InputFillFocused" Color="#1F1F1F" />
    <SolidColorBrush x:Key="Cm.ControlStroke" Color="#434343" />
    <SolidColorBrush x:Key="Cm.ControlStrokeStrong" Color="#9A9A9A" />
    <SolidColorBrush x:Key="Cm.SubtleFillHover" Color="#0FFFFFFF" />
    <SolidColorBrush x:Key="Cm.SubtleFillPressed" Color="#0AFFFFFF" />
    <SolidColorBrush x:Key="Cm.SubtleFillSelected" Color="#0FFFFFFF" />

    <LinearGradientBrush x:Key="Cm.ControlElevationBorder" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="#3A3A3A" />
        <GradientStop Offset="1.0" Color="#454545" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Cm.TextControlBorder" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,2">
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.5" Color="#9A9A9A" />
        <GradientStop Offset="0.5" Color="#434343" />
    </LinearGradientBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="Cm.TextPrimary" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Cm.TextSecondary" Color="#C8C8C8" />
    <SolidColorBrush x:Key="Cm.TextTertiary" Color="#9E9E9E" />
    <SolidColorBrush x:Key="Cm.TextDisabled" Color="#717171" />

    <!-- Status -->
    <SolidColorBrush x:Key="Cm.Success" Color="#6CCB5F" />
    <SolidColorBrush x:Key="Cm.Caution" Color="#FCE100" />
    <SolidColorBrush x:Key="Cm.Critical" Color="#FF99A4" />
    <SolidColorBrush x:Key="Cm.Neutral" Color="#9E9E9E" />
    <SolidColorBrush x:Key="Cm.SuccessBackground" Color="#393D1B" />
    <SolidColorBrush x:Key="Cm.CautionBackground" Color="#433519" />
    <SolidColorBrush x:Key="Cm.CriticalBackground" Color="#442726" />
    <SolidColorBrush x:Key="Cm.NeutralBackground" Color="#333333" />

    <Color x:Key="Cm.WindowGlowColor">#80000000</Color>
    <SolidColorBrush x:Key="Cm.WindowGlow" Color="#80000000" />
    <SolidColorBrush x:Key="Cm.WindowGlowInactive" Color="#50000000" />
</ResourceDictionary>
