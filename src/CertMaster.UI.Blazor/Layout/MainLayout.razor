@inherits LayoutComponentBase
@implements IDisposable
@inject HubSession Session
@inject HubClient Hub
@inject NavigationManager Nav

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_dark" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@if (!_ready)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!Session.IsAuthenticated)
{
    @Body
}
else
{
    <MudLayout>
        <MudAppBar Elevation="1" Color="Color.Primary">
            <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="() => _drawer = !_drawer" />
            <MudIcon Icon="@Icons.Material.Filled.VerifiedUser" Class="mr-2" />
            <MudText Typo="Typo.h6">CertMaster Management Hub</MudText>
            <MudSpacer />
            <MudIconButton Icon="@(_dark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)" Color="Color.Inherit" OnClick="() => _dark = !_dark" />
            <MudMenu Icon="@Icons.Material.Filled.AccountCircle" Color="Color.Inherit" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                <MudMenuItem Disabled="true">@Session.Username</MudMenuItem>
                <MudMenuItem Href="/account/password" Icon="@Icons.Material.Filled.Password">Change password</MudMenuItem>
                <MudMenuItem OnClick="Logout" Icon="@Icons.Material.Filled.Logout">Sign out</MudMenuItem>
            </MudMenu>
        </MudAppBar>
        <MudDrawer @bind-Open="_drawer" ClipMode="DrawerClipMode.Always" Elevation="1" Variant="DrawerVariant.Responsive">
            <MudNavMenu>
                <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                <MudNavLink Href="/certificates" Icon="@Icons.Material.Filled.Lock">Certificates</MudNavLink>
                <MudNavLink Href="/instances" Icon="@Icons.Material.Filled.Dns">Instances</MudNavLink>
                <MudNavGroup Title="Settings" Icon="@Icons.Material.Filled.Settings" Expanded="true">
                    <MudNavLink Href="/accounts" Icon="@Icons.Material.Filled.AccountBalance">Certificate Authorities</MudNavLink>
                    <MudNavLink Href="/credentials" Icon="@Icons.Material.Filled.Key">Stored Credentials</MudNavLink>
                    @if (Session.IsAdmin)
                    {
                        <MudNavLink Href="/admin/users" Icon="@Icons.Material.Filled.People">Users &amp; Roles</MudNavLink>
                    }
                </MudNavGroup>
                <MudNavLink Href="/docs" ForceLoad="true" Target="_blank" Icon="@Icons.Material.Filled.Api">API Reference</MudNavLink>
            </MudNavMenu>
        </MudDrawer>
        <MudMainContent>
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-6">
                @Body
            </MudContainer>
        </MudMainContent>
    </MudLayout>
}

@code {
    private bool _ready, _drawer = true, _dark;
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight { Primary = "#1565c0", AppbarBackground = "#0d47a1", Secondary = "#00897b" },
        PaletteDark = new PaletteDark { Primary = "#64b5f6", Secondary = "#4db6ac" },
    };

    protected override async Task OnInitializedAsync()
    {
        await Session.EnsureLoadedAsync();
        Session.Changed += OnChanged;
        Nav.LocationChanged += OnLocation;
        _ready = true;
        Guard();
    }

    private void OnChanged() { Guard(); InvokeAsync(StateHasChanged); }
    private void OnLocation(object? s, LocationChangedEventArgs e) => Guard();

    private void Guard()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        if (!Session.IsAuthenticated && path != "/login") Nav.NavigateTo("/login");
    }

    private async Task Logout()
    {
        await Hub.LogoutAsync();
        Nav.NavigateTo("/login");
    }

    public void Dispose()
    {
        Session.Changed -= OnChanged;
        Nav.LocationChanged -= OnLocation;
    }
}
