@* Adds a stored credential of one fixed type on an instance; returns the saved credential. *@
@inject HubClient Hub

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">New @Type.Title credential</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">Stored encrypted on the instance (DPAPI on Windows) and never sent back to the hub or browser.</MudText>
        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Class="mb-3" />
        <ParameterEditor Definitions="Type.Fields" Settings="_values" IncludeCredentialFields="true" />
        @if (_error != null) { <MudAlert Severity="Severity.Warning" Dense="true">@_error</MudAlert> }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save" Disabled="_saving">Save credential</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public string InstanceId { get; set; } = "";
    [Parameter, EditorRequired] public CredentialTypeDefinition Type { get; set; } = new();

    private string _title = "";
    private readonly List<ProviderParameterSetting> _values = new();
    private string? _error;
    private bool _saving;

    protected override void OnInitialized() => _title = Type.Title;

    private void Cancel() => MudDialog.Cancel();

    private async Task Save()
    {
        var dict = _values.Where(v => !string.IsNullOrWhiteSpace(v.Value)).ToDictionary(v => v.Key, v => v.Value!.Trim());
        var missing = Type.Fields.Where(f => f.IsRequired && !dict.ContainsKey(f.Key)).Select(f => f.Name).ToList();
        if (missing.Count > 0) { _error = "Fill in: " + string.Join(", ", missing) + "."; return; }
        if (dict.Count == 0) { _error = "Enter at least one value."; return; }
        _saving = true; _error = null;
        try
        {
            var saved = await Hub.SaveCredentialAsync(InstanceId, new StoredCredential
            {
                ProviderType = Type.ProviderType,
                Title = string.IsNullOrWhiteSpace(_title) ? Type.Title : _title.Trim(),
                Secret = JsonDefaults.Serialize(dict),
            });
            MudDialog.Close(DialogResult.Ok(saved));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _saving = false; }
    }
}
