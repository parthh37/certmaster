@page "/credentials"
@inject HubClient Hub
@inject HubSession Session
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Stored Credentials - CertMaster</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
    <MudText Typo="Typo.h4">Stored Credentials</MudText>
    <MudSpacer />
    <InstanceSelector Value="_iid" ValueChanged="Select" />
</MudStack>

@if (_iid == null) { <MudAlert Severity="Severity.Info">Select a connected instance.</MudAlert> return; }

<MudText Typo="Typo.body2" Class="mb-3">Secrets are encrypted on the instance (DPAPI on Windows) and are never sent back to the hub or browser.</MudText>

<MudGrid>
    <MudItem xs="12" md="7">
        <MudPaper Class="pa-4" Elevation="1">
            <MudSimpleTable Dense="true">
                <thead><tr><th>Title</th><th>Type</th><th>Created</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in _creds)
                    {
                        <tr>
                            <td>@c.Title</td><td>@(_types.FirstOrDefault(t => t.ProviderType == c.ProviderType)?.Title ?? c.ProviderType)</td>
                            <td>@c.DateCreated.ToLocalTime().ToString("g")</td>
                            <td>
                                @if (Session.CanManage)
                                {
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" OnClick="@(() => Edit(c))" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Delete(c))" />
                                }
                            </td>
                        </tr>
                    }
                    @if (_creds.Count == 0) { <tr><td colspan="4">No stored credentials.</td></tr> }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    </MudItem>
    @if (Session.CanManage)
    {
        <MudItem xs="12" md="5">
            <MudPaper Class="pa-4" Elevation="1">
                <MudText Typo="Typo.h6" Class="mb-2">@(_editing.StorageKey == _newKey ? "Add credential" : "Update credential")</MudText>
                <MudSelect T="string" @bind-Value="_editing.ProviderType" Label="Type" Variant="Variant.Outlined" Class="mb-3" Disabled="_editing.StorageKey != _newKey">
                    @foreach (var t in _types) { <MudSelectItem T="string" Value="@t.ProviderType">@t.Title</MudSelectItem> }
                </MudSelect>
                <MudTextField @bind-Value="_editing.Title" Label="Title" Variant="Variant.Outlined" Class="mb-3" />
                @if (_types.FirstOrDefault(t => t.ProviderType == _editing.ProviderType) is { } type)
                {
                    @if (_editing.StorageKey != _newKey) { <MudText Typo="Typo.caption" Class="mb-2 d-block">Leave fields blank to keep the existing secret.</MudText> }
                    <ParameterEditor Definitions="type.Fields" Settings="_values" IncludeCredentialFields="true" />
                }
                <MudStack Row="true">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="string.IsNullOrEmpty(_editing.ProviderType)">Save</MudButton>
                    <MudButton OnClick="Reset">Clear</MudButton>
                </MudStack>
            </MudPaper>
        </MudItem>
    }
</MudGrid>

@code {
    private string? _iid;
    private List<StoredCredential> _creds = new();
    private List<CredentialTypeDefinition> _types = new();
    private StoredCredential _editing = new();
    private string _newKey = "";
    private List<ProviderParameterSetting> _values = new();

    protected override void OnInitialized() => Reset();

    private void Reset()
    {
        _editing = new StoredCredential();
        _newKey = _editing.StorageKey;
        _values = new();
    }

    private async Task Select(string? iid)
    {
        _iid = iid;
        if (iid == null) return;
        try { _types = await Hub.GetCredentialTypesAsync(iid); _creds = await Hub.GetCredentialsAsync(iid); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void Edit(StoredCredential c)
    {
        _editing = new StoredCredential { StorageKey = c.StorageKey, ProviderType = c.ProviderType, Title = c.Title, DateCreated = c.DateCreated };
        _newKey = "";
        _values = new();
    }

    private async Task Save()
    {
        var dict = _values.Where(v => !string.IsNullOrEmpty(v.Value)).ToDictionary(v => v.Key, v => v.Value!);
        var isNew = _editing.StorageKey == _newKey;
        var type = _types.First(t => t.ProviderType == _editing.ProviderType);
        if (isNew && type.Fields.Any(f => f.IsRequired && !dict.ContainsKey(f.Key))) { Snackbar.Add("Fill in all required fields", Severity.Warning); return; }
        if (string.IsNullOrWhiteSpace(_editing.Title)) _editing.Title = type.Title;
        _editing.Secret = dict.Count > 0 ? JsonDefaults.Serialize(dict) : null;
        try
        {
            await Hub.SaveCredentialAsync(_iid!, _editing);
            Snackbar.Add("Credential saved", Severity.Success);
            Reset();
            await Select(_iid);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete(StoredCredential c)
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete credential", $"Delete '{c.Title}'? Any certificate or task using it will fail.", yesText: "Delete", cancelText: "Cancel") != true) return;
        try { await Hub.DeleteCredentialAsync(_iid!, c.StorageKey); await Select(_iid); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
