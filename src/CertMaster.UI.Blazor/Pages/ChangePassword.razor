@page "/account/password"
@inject HubClient Hub
@inject ISnackbar Snackbar

<PageTitle>Change password - CertMaster</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Change password</MudText>
<MudPaper Class="pa-4" Elevation="1" Style="max-width:480px">
    <MudTextField @bind-Value="_req.CurrentPassword" Label="Current password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_req.NewPassword" Label="New password (min 10 characters)" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
    <MudTextField @bind-Value="_confirm" Label="Confirm new password" InputType="InputType.Password" Variant="Variant.Outlined" Class="mb-3" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save">Change password</MudButton>
</MudPaper>

@code {
    private ChangePasswordRequest _req = new();
    private string _confirm = "";

    private async Task Save()
    {
        if (_req.NewPassword != _confirm) { Snackbar.Add("Passwords do not match", Severity.Warning); return; }
        try
        {
            var r = await Hub.ChangePasswordAsync(_req);
            Snackbar.Add(r.Message ?? "", r.IsSuccess ? Severity.Success : Severity.Error);
            if (r.IsSuccess) { _req = new(); _confirm = ""; }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
