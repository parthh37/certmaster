@page "/certificates/{InstanceId}/{Id}"
@implements IDisposable
@inject HubClient Hub
@inject HubSession Session
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject IJSRuntime JS

<PageTitle>@(_item?.Name ?? "Certificate") - CertMaster</PageTitle>

@if (_item == null)
{
    @if (_error != null) { <MudAlert Severity="Severity.Error">@_error</MudAlert> }
    else { <MudProgressLinear Indeterminate="true" /> }
    return;
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4" Wrap="Wrap.Wrap">
    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Href="/certificates" />
    <div>
        <MudText Typo="Typo.h5">@(IsNew ? "New certificate" : _item.Name)</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">on @_instanceTitle</MudText>
    </div>
    @if (!IsNew) { <HealthChip Health="_item.Health" /> }
    <MudSpacer />
    @if (Session.CanManage)
    {
        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Science" OnClick="Test" Disabled="_busy">Test</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Save" OnClick="Save" Disabled="_busy">Save</MudButton>
        @if (!IsNew)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Success" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="RequestNow" Disabled="_busy">Request certificate</MudButton>
            <MudMenu Icon="@Icons.Material.Filled.MoreVert">
                <MudMenuItem OnClick="@(() => Download(CertificateDownloadFormat.pfx))" Icon="@Icons.Material.Filled.Download">Download PFX</MudMenuItem>
                <MudMenuItem OnClick="@(() => Download(CertificateDownloadFormat.pem_chain))" Icon="@Icons.Material.Filled.Download">Download PEM (full chain)</MudMenuItem>
                <MudMenuItem OnClick="Revoke" Icon="@Icons.Material.Filled.Block">Revoke certificate</MudMenuItem>
                <MudMenuItem OnClick="Delete" Icon="@Icons.Material.Filled.Delete">Delete</MudMenuItem>
            </MudMenu>
        }
    }
</MudStack>

@if (_progress != null && !_progress.IsFinal)
{
    <MudAlert Severity="Severity.Info" Class="mb-3" Icon="@Icons.Material.Filled.Sync">@_progress.Message</MudAlert>
    <MudProgressLinear Indeterminate="true" Class="mb-3" />
}
@if (_item.RenewalFailureMessage != null && _item.Health == ManagedCertificateHealth.Error)
{
    <MudAlert Severity="Severity.Error" Class="mb-3">Last request failed: @_item.RenewalFailureMessage</MudAlert>
}
@if (_testResults != null)
{
    <MudPaper Class="pa-3 mb-3" Outlined="true">
        <MudStack Row="true" AlignItems="AlignItems.Center"><MudText Typo="Typo.subtitle1">Test results</MudText><MudSpacer /><MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Close" OnClick="() => _testResults = null" /></MudStack>
        @foreach (var s in _testResults)
        {
            <MudAlert Severity="@(s.HasError ? Severity.Error : Severity.Success)" Dense="true" Class="mb-1"><b>@s.Title</b>: @s.Description</MudAlert>
        }
    </MudPaper>
}

<MudTabs Elevation="1" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
    <MudTabPanel Text="Certificate" Icon="@Icons.Material.Filled.Lock">
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudTextField @bind-Value="_item.Name" Label="Name" Variant="Variant.Outlined" Class="mb-3" HelperText="Defaults to the primary domain" />
                <MudTextField @bind-Value="_item.RequestConfig.PrimaryDomain" Label="Primary domain" Variant="Variant.Outlined" Class="mb-3" Required="true" />
                <MudTextField @bind-Value="_sanText" Label="Additional domains (one per line, wildcards allowed)" Variant="Variant.Outlined" Lines="5" Class="mb-3" />
                <MudTextField @bind-Value="_ipText" Label="IP addresses (optional, one per line)" Variant="Variant.Outlined" Lines="2" Class="mb-3" />
                <MudTextField @bind-Value="_item.Comments" Label="Comments" Variant="Variant.Outlined" Lines="2" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudSelect T="string" @bind-Value="_item.CertificateAuthorityId" Label="Certificate Authority" Variant="Variant.Outlined" Class="mb-3">
                    @foreach (var ca in _authorities)
                    {
                        <MudSelectItem T="string" Value="@ca.Id">@ca.Title @(HasAccount(ca.Id) ? "" : "(no account)")</MudSelectItem>
                    }
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_item.UseStagingMode" Color="Color.Warning" Label="Use staging (test) environment" />
                <MudSwitch T="bool" @bind-Value="_item.IncludeInAutoRenew" Color="Color.Primary" Label="Auto renew" />
                <MudSelect T="string" @bind-Value="_item.RequestConfig.CSRKeyAlg" Label="Key type" Variant="Variant.Outlined" Class="my-3">
                    <MudSelectItem T="string" Value="@("RS256")">RSA 2048</MudSelectItem>
                    <MudSelectItem T="string" Value="@("RS256-3072")">RSA 3072</MudSelectItem>
                    <MudSelectItem T="string" Value="@("RS256-4096")">RSA 4096</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ES256")">ECDSA P-256</MudSelectItem>
                    <MudSelectItem T="string" Value="@("ES384")">ECDSA P-384</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" @bind-Value="_item.RequestConfig.ReusePrivateKey" Label="Reuse private key on renewal" />
                <MudTextField @bind-Value="_item.RequestConfig.PreferredChain" Label="Preferred chain (issuer CN, optional)" Variant="Variant.Outlined" Class="my-3" />
                <MudTextField @bind-Value="_item.RequestConfig.AcmeProfile" Label="ACME profile (optional, e.g. tlsserver, shortlived)" Variant="Variant.Outlined" Class="mb-3" />
                <MudNumericField T="int?" @bind-Value="_item.CustomRenewalDaysBeforeExpiry" Label="Renew N days before expiry (blank = default)" Variant="Variant.Outlined" Class="mb-3" Min="1" />
                <MudSelect T="string" @bind-Value="_item.CertificatePasswordCredentialId" Label="PFX password (stored credential)" Variant="Variant.Outlined" Clearable="true">
                    @foreach (var c in _credentials.Where(c => c.ProviderType == "ProtectedPFX"))
                    {
                        <MudSelectItem T="string" Value="@c.StorageKey">@c.Title</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (!IsNew && _item.DateExpiry != null)
        {
            <MudDivider Class="my-4" />
            <MudSimpleTable Dense="true">
                <tbody>
                    <tr><td>Valid</td><td>@_item.DateStart?.ToLocalTime().ToString("g") to @_item.DateExpiry?.ToLocalTime().ToString("g")</td></tr>
                    <tr><td>Issuer</td><td>@_item.CertificateIssuer</td></tr>
                    <tr><td>Thumbprint</td><td class="cm-mono">@_item.CertificateThumbprintHash</td></tr>
                    <tr><td>Last renewed</td><td>@_item.DateRenewed?.ToLocalTime().ToString("g")</td></tr>
                    <tr><td>Files</td><td class="cm-mono">@_item.CertificatePath</td></tr>
                </tbody>
            </MudSimpleTable>
        }
    </MudTabPanel>

    <MudTabPanel Text="Authorization" Icon="@Icons.Material.Filled.VerifiedUser">
        <MudText Typo="Typo.body2" Class="mb-3">
            How the CA verifies you control each domain. Use <b>http-01</b> for public web servers on port 80, or <b>dns-01</b> for wildcards and internal hosts.
            Add more configurations with a domain match to use different methods per domain.
        </MudText>
        @foreach (var cfg in _item.RequestConfig.Challenges)
        {
            var c = cfg;
            <MudPaper Outlined="true" Class="pa-4 mb-3">
                <MudGrid>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" Value="c.ChallengeType" ValueChanged="@(v => { c.ChallengeType = v; c.ChallengeProvider = v == ChallengeTypes.Http01 ? "HTTP01.BuiltIn" : null; })" Label="Challenge type" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@ChallengeTypes.Http01">http-01</MudSelectItem>
                            <MudSelectItem T="string" Value="@ChallengeTypes.Dns01">dns-01</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudSelect T="string" @bind-Value="c.ChallengeProvider" Label="Provider" Variant="Variant.Outlined">
                            @foreach (var p in _challengeProviders.Where(p => p.ChallengeType == c.ChallengeType))
                            {
                                <MudSelectItem T="string" Value="@p.Id">@p.Title</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" md="4">
                        @if (ProviderFor(c)?.CredentialType is { } credType)
                        {
                            <MudSelect T="string" @bind-Value="c.ChallengeCredentialKey" Label="Credentials" Variant="Variant.Outlined" HelperText="Manage in Stored Credentials">
                                @foreach (var sc in _credentials.Where(x => x.ProviderType == credType))
                                {
                                    <MudSelectItem T="string" Value="@sc.StorageKey">@sc.Title</MudSelectItem>
                                }
                            </MudSelect>
                        }
                    </MudItem>
                    <MudItem xs="12" md="6">
                        <MudTextField @bind-Value="c.DomainMatch" Label="Apply to domains (optional, comma separated)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudItem>
                    @if (c.ChallengeType == ChallengeTypes.Dns01)
                    {
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="c.ChallengeDelegationRule" Label="CNAME delegation rule (optional)" Placeholder="*.example.com:*.auth.example.net" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudNumericField T="int?" @bind-Value="c.PropagationDelaySeconds" Label="Propagation delay (seconds)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField @bind-Value="c.ZoneId" Label="DNS zone id (optional)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                    @if (ProviderFor(c) is { } def && def.ProviderParameters.Any(p => !p.IsCredential))
                    {
                        <MudItem xs="12"><ParameterEditor Definitions="def.ProviderParameters" Settings="c.Parameters" /></MudItem>
                    }
                </MudGrid>
                @if (_item.RequestConfig.Challenges.Count > 1)
                {
                    <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => _item.RequestConfig.Challenges.Remove(c))">Remove</MudButton>
                }
            </MudPaper>
        }
        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => _item.RequestConfig.Challenges.Add(new CertRequestChallengeConfig { ChallengeProvider = "HTTP01.BuiltIn" }))">Add authorization config</MudButton>
    </MudTabPanel>

    <MudTabPanel Text="Deployment" Icon="@Icons.Material.Filled.Dns">
        <MudText Typo="Typo.body2" Class="mb-3">
            Certificates can be applied to IIS bindings on the instance automatically, or deployed with tasks. @_serverStatusText
        </MudText>
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudSelect T="string" Value="_item.ServerSiteId" ValueChanged="OnSiteChanged" Label="Website (IIS site)" Variant="Variant.Outlined" Clearable="true" Disabled="_sites.Count == 0" Class="mb-3">
                    @foreach (var s in _sites) { <MudSelectItem T="string" Value="@s.Id">@s.Name</MudSelectItem> }
                </MudSelect>
                <MudSelect T="DeploymentOption" @bind-Value="_item.RequestConfig.DeploymentSiteOption" Label="Deployment mode" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="DeploymentOption" Value="DeploymentOption.Auto">Auto</MudSelectItem>
                    <MudSelectItem T="DeploymentOption" Value="DeploymentOption.SingleSite">Single site (selected above)</MudSelectItem>
                    <MudSelectItem T="DeploymentOption" Value="DeploymentOption.AllSites">All sites</MudSelectItem>
                    <MudSelectItem T="DeploymentOption" Value="DeploymentOption.CertificateStoreOnly">Certificate store only</MudSelectItem>
                    <MudSelectItem T="DeploymentOption" Value="DeploymentOption.NoDeployment">No deployment</MudSelectItem>
                </MudSelect>
                <MudSelect T="DeploymentBindingOption" @bind-Value="_item.RequestConfig.DeploymentBindingOption" Label="Binding add/update" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem T="DeploymentBindingOption" Value="DeploymentBindingOption.AddOrUpdate">Add or update https bindings as required</MudSelectItem>
                    <MudSelectItem T="DeploymentBindingOption" Value="DeploymentBindingOption.UpdateOnly">Update existing https bindings only</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="6">
                <MudText Typo="Typo.subtitle2">Update existing bindings matching any of:</MudText>
                <MudCheckBox T="bool" @bind-Value="_item.RequestConfig.DeploymentBindingMatchHostname" Label="Binding hostname matches certificate domains" />
                <MudCheckBox T="bool" @bind-Value="_item.RequestConfig.DeploymentBindingBlankHostname" Label="Binding hostname not specified (IP only / all unassigned)" />
                <MudCheckBox T="bool" @bind-Value="_item.RequestConfig.DeploymentBindingReplacePrevious" Label="Binding uses the previous version of this certificate" />
                <MudText Typo="Typo.subtitle2" Class="mt-3">New bindings</MudText>
                <MudRadioGroup T="bool" @bind-Value="_item.RequestConfig.UseSpecificBindingIPPort">
                    <MudRadio T="bool" Value="false">Auto create/update bindings (SNI)</MudRadio>
                    <MudRadio T="bool" Value="true">Use specific IP/port</MudRadio>
                </MudRadioGroup>
                @if (_item.RequestConfig.UseSpecificBindingIPPort)
                {
                    <MudStack Row="true">
                        <MudTextField @bind-Value="_item.RequestConfig.BindingIPAddress" Label="IP (* = all)" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField T="int" @bind-Value="_item.RequestConfig.BindingPort" Label="Port" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudCheckBox T="bool" @bind-Value="_item.RequestConfig.BindingUseSNI" Label="SNI" />
                    </MudStack>
                }
            </MudItem>
        </MudGrid>
    </MudTabPanel>

    <MudTabPanel Text="Preview" Icon="@Icons.Material.Filled.PlayCircleOutline" OnClick="LoadPreview">
        <MudStack Row="true" Class="mb-2"><MudText Typo="Typo.body2">What a request would do with the current (unsaved) settings. Nothing is changed.</MudText><MudSpacer /><MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadPreview">Refresh</MudButton></MudStack>
        @if (_preview == null) { <MudProgressLinear Indeterminate="true" /> }
        else
        {
            @foreach (var s in _preview)
            {
                <MudPaper Outlined="true" Class="pa-3 mb-2">
                    <MudText Typo="Typo.subtitle1" Color="@(s.HasError ? Color.Error : Color.Default)">@s.Title</MudText>
                    <MudText Typo="Typo.body2">@s.Description</MudText>
                    @foreach (var sub in s.Substeps) { <MudText Typo="Typo.body2" Class="ml-4">• <b>@sub.Title</b> @sub.Description</MudText> }
                </MudPaper>
            }
        }
    </MudTabPanel>

    <MudTabPanel Text="Tasks" Icon="@Icons.Material.Filled.PlaylistPlay">
        @TaskList("Deployment tasks (after request)", _item.PostRequestTasks, false)
        <MudDivider Class="my-4" />
        @TaskList("Pre-request tasks", _item.PreRequestTasks, true)
        <MudDivider Class="my-4" />
        <MudText Typo="Typo.h6" Class="mb-2">Webhook</MudText>
        <MudGrid>
            <MudItem xs="12" md="3">
                <MudSelect T="string" @bind-Value="_item.RequestConfig.WebhookTrigger" Label="Trigger" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem T="string" Value="@("none")">None</MudSelectItem>
                    <MudSelectItem T="string" Value="@("on_success")">On success</MudSelectItem>
                    <MudSelectItem T="string" Value="@("on_error")">On error</MudSelectItem>
                    <MudSelectItem T="string" Value="@("always")">Always</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" md="9"><MudTextField @bind-Value="_item.RequestConfig.WebhookUrl" Label="URL" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
        </MudGrid>
    </MudTabPanel>

    @if (!IsNew)
    {
        <MudTabPanel Text="Log" Icon="@Icons.Material.Filled.Article" OnClick="LoadLog">
            <MudStack Row="true" Class="mb-2"><MudSpacer /><MudButton StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadLog">Refresh</MudButton></MudStack>
            <div class="cm-log cm-mono">
                @foreach (var l in _log)
                {
                    <div class="@l.Level">@l.Timestamp.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss") [@l.Level] @l.Message</div>
                }
                @if (_log.Count == 0) { <div>No log entries yet.</div> }
            </div>
        </MudTabPanel>
    }
</MudTabs>

@code {
    [Parameter] public string InstanceId { get; set; } = "";
    [Parameter] public string Id { get; set; } = "";

    private bool IsNew => Id == "new";
    private ManagedCertificate? _item;
    private string _sanText = "", _ipText = "", _instanceTitle = "";
    private string? _error;
    private bool _busy;
    private List<ChallengeProviderDefinition> _challengeProviders = new();
    private List<DeploymentProviderDefinition> _deploymentProviders = new();
    private List<StoredCredential> _credentials = new();
    private List<CertificateAuthority> _authorities = new();
    private List<AccountDetails> _accounts = new();
    private List<ActionStep>? _testResults;
    private List<LogEntry> _log = new();
    private RequestProgressState? _progress;
    private Timer? _poll;
    private string? _newTaskType;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var instances = await Hub.GetInstancesAsync();
            _instanceTitle = instances.FirstOrDefault(i => i.InstanceId == InstanceId)?.Title ?? InstanceId;
            var t1 = Hub.GetChallengeProvidersAsync(InstanceId);
            var t2 = Hub.GetDeploymentProvidersAsync(InstanceId);
            var t3 = Hub.GetCredentialsAsync(InstanceId);
            var t4 = Hub.GetAuthoritiesAsync(InstanceId);
            var t5 = Hub.GetAccountsAsync(InstanceId);
            _challengeProviders = await t1; _deploymentProviders = await t2; _credentials = await t3; _authorities = await t4; _accounts = await t5;
            try
            {
                var status = await Hub.GetServerStatusAsync(InstanceId);
                _serverStatusText = status.IsIisAvailable ? $"IIS {status.IisVersion} detected on this instance." : (status.Message ?? "IIS not detected on this instance.");
                if (status.IsIisAvailable) _sites = await Hub.GetSitesAsync(InstanceId);
            }
            catch { _serverStatusText = "Could not query the instance's web server."; }

            _item = IsNew
                ? new ManagedCertificate { RequestConfig = new CertRequestConfig { Challenges = { new CertRequestChallengeConfig { ChallengeProvider = "HTTP01.BuiltIn" } } } }
                : await Hub.GetItemAsync(InstanceId, Id);
            _item.RequestConfig.WebhookTrigger ??= "none";
            _sanText = string.Join("\n", _item.RequestConfig.SubjectAlternativeNames.Where(d => d != _item.RequestConfig.PrimaryDomain));
            _ipText = string.Join("\n", _item.RequestConfig.SubjectIPAddresses);
            if (!IsNew) _poll = new Timer(async _ => await PollProgress(), null, 0, 3000);
        }
        catch (Exception ex) { _error = ex.Message; }
    }

    private bool HasAccount(string caId) => _accounts.Any(a => a.CertificateAuthorityId == caId);
    private ChallengeProviderDefinition? ProviderFor(CertRequestChallengeConfig c) => _challengeProviders.FirstOrDefault(p => p.Id == c.ChallengeProvider);
    private DeploymentProviderDefinition? TaskDef(DeploymentTaskConfig t) => _deploymentProviders.FirstOrDefault(p => p.Id == t.TaskTypeId);

    private void ApplyText()
    {
        static List<string> Lines(string s) => s.Split(new[] { '\n', '\r', ',', ' ' }, StringSplitOptions.RemoveEmptyEntries).Select(x => x.Trim()).ToList();
        _item!.RequestConfig.SubjectAlternativeNames = Lines(_sanText);
        _item.RequestConfig.SubjectIPAddresses = Lines(_ipText);
    }

    private async Task Save()
    {
        ApplyText();
        _busy = true;
        try
        {
            var r = await Hub.SaveItemAsync(InstanceId, _item!);
            if (!r.IsSuccess) { Snackbar.Add(r.Message ?? "Save failed", Severity.Error); return; }
            Snackbar.Add("Saved", Severity.Success);
            if (IsNew) Nav.NavigateTo($"/certificates/{InstanceId}/{r.Result!.Id}", replace: true);
            else _item = r.Result;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Test()
    {
        ApplyText();
        _busy = true;
        try { _testResults = await Hub.TestItemAsync(InstanceId, _item!); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RequestNow()
    {
        try
        {
            var r = await Hub.RequestItemAsync(InstanceId, Id);
            Snackbar.Add(r.Message ?? "Request started", r.IsSuccess ? Severity.Info : Severity.Warning);
            _progress = new RequestProgressState { Message = "Starting request..." };
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task PollProgress()
    {
        try
        {
            var p = await Hub.GetItemProgressAsync(InstanceId, Id);
            var finishedNow = p?.IsFinal == true && _progress is { IsFinal: false };
            _progress = p;
            if (finishedNow)
            {
                _item = await Hub.GetItemAsync(InstanceId, Id);
                Snackbar.Add(p!.Message ?? "Request finished", p.CurrentState == RequestState.Error ? Severity.Error : Severity.Success);
            }
            await InvokeAsync(StateHasChanged);
        }
        catch { /* transient */ }
    }

    private async Task LoadLog()
    {
        try { _log = await Hub.GetItemLogAsync(InstanceId, Id); _log.Reverse(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Download(CertificateDownloadFormat format)
    {
        try
        {
            var (data, name) = await Hub.DownloadItemAsync(InstanceId, Id, format);
            await JS.InvokeVoidAsync("certmasterDownload", name, Convert.ToBase64String(data));
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Revoke()
    {
        if (await Dialogs.ShowMessageBoxAsync("Revoke certificate", "Revoke the current certificate with the CA? This cannot be undone.", yesText: "Revoke", cancelText: "Cancel") != true) return;
        try { var r = await Hub.RevokeItemAsync(InstanceId, Id); Snackbar.Add(r.Message ?? "", r.IsSuccess ? Severity.Success : Severity.Error); _item = await Hub.GetItemAsync(InstanceId, Id); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Delete()
    {
        if (await Dialogs.ShowMessageBoxAsync("Delete", $"Delete managed certificate '{_item!.Name}'? Issued certificate files remain on the server.", yesText: "Delete", cancelText: "Cancel") != true) return;
        try { await Hub.DeleteItemAsync(InstanceId, Id); Nav.NavigateTo("/certificates"); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private void AddTask(List<DeploymentTaskConfig> list)
    {
        var def = _deploymentProviders.FirstOrDefault(p => p.Id == _newTaskType);
        if (def == null) return;
        list.Add(new DeploymentTaskConfig { TaskTypeId = def.Id, TaskName = def.DefaultTitle, TaskTrigger = TaskTriggerType.ON_SUCCESS });
        _newTaskType = null;
    }

    private List<SiteInfo> _sites = new();
    private string _serverStatusText = "";
    private List<ActionStep>? _preview;

    private async Task OnSiteChanged(string? siteId)
    {
        _item!.ServerSiteId = siteId;
        if (siteId == null) return;
        try
        {
            var options = await Hub.GetSiteDomainsAsync(InstanceId, siteId);
            var existing = new HashSet<string>(_item.GetAllDomains(), StringComparer.OrdinalIgnoreCase);
            var add = options.Where(o => o.IsSelected && !existing.Contains(o.Domain)).Select(o => o.Domain).ToList();
            if (string.IsNullOrWhiteSpace(_item.RequestConfig.PrimaryDomain) && add.Count > 0) { _item.RequestConfig.PrimaryDomain = add[0]; add.RemoveAt(0); }
            if (add.Count > 0) _sanText = string.Join("\n", _sanText.Split('\n', StringSplitOptions.RemoveEmptyEntries).Concat(add));
            if (add.Count > 0 || options.Count > 0) Snackbar.Add($"Loaded {options.Count} hostname(s) from the site bindings", Severity.Info);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task LoadPreview()
    {
        ApplyText();
        _preview = null;
        try { _preview = await Hub.PreviewItemAsync(InstanceId, _item!); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); _preview = new(); }
    }

    private async Task RunTask(DeploymentTaskConfig task)
    {
        if (IsNew) { Snackbar.Add("Save the certificate first", Severity.Warning); return; }
        try
        {
            var r = await Hub.RunTaskAsync(InstanceId, Id, task.Id);
            Snackbar.Add($"{task.TaskName}: {r.Message}", r.IsSuccess ? Severity.Success : Severity.Warning);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static readonly Dictionary<DeploymentContextType, string> TargetTitles = new()
    {
        [DeploymentContextType.LocalAsService] = "Local (as the CertMaster service)",
        [DeploymentContextType.LocalAsUser] = "Local (as a specific Windows user)",
        [DeploymentContextType.WindowsNetwork] = "Windows network share (UNC)",
        [DeploymentContextType.SSH] = "Remote host via SSH / SFTP",
    };

    private static string? TaskCredentialType(DeploymentTaskConfig t, DeploymentProviderDefinition? def) => t.TargetType switch
    {
        DeploymentContextType.SSH => "SSH",
        DeploymentContextType.WindowsNetwork or DeploymentContextType.LocalAsUser => "Windows",
        _ => def?.CredentialType,
    };

    private RenderFragment TaskList(string title, List<DeploymentTaskConfig> tasks, bool pre) => __builder =>
    {
        <MudText Typo="Typo.h6" Class="mb-2">@title</MudText>
        <MudExpansionPanels MultiExpansion="true" Class="mb-3">
            @foreach (var t in tasks)
            {
                var task = t;
                var def = TaskDef(task);
                <MudExpansionPanel Text="@($"{task.TaskName}  ({def?.Title ?? task.TaskTypeId})  {(task.LastRunStatus == RequestState.NotRunning ? "" : "- last run: " + task.LastRunStatus)}")">
                    <MudGrid>
                        <MudItem xs="12" md="6"><MudTextField @bind-Value="task.TaskName" Label="Task name" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                        <MudItem xs="12" md="3">
                            <MudSelect T="TaskTriggerType" @bind-Value="task.TaskTrigger" Label="Trigger" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem T="TaskTriggerType" Value="TaskTriggerType.ON_SUCCESS">On success</MudSelectItem>
                                <MudSelectItem T="TaskTriggerType" Value="TaskTriggerType.ON_ERROR">On error</MudSelectItem>
                                <MudSelectItem T="TaskTriggerType" Value="TaskTriggerType.ANY_STATUS">Always</MudSelectItem>
                                <MudSelectItem T="TaskTriggerType" Value="TaskTriggerType.MANUAL">Manual only</MudSelectItem>
                                <MudSelectItem T="TaskTriggerType" Value="TaskTriggerType.NOT_ENABLED">Disabled</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" md="3"><MudNumericField T="int" @bind-Value="task.RetriesAllowed" Label="Retries" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Max="10" /></MudItem>
                        <MudItem xs="12">
                            <MudSwitch T="bool" @bind-Value="task.IsFatalOnError" Label="Stop remaining tasks if this fails" />
                            <MudSwitch T="bool" @bind-Value="task.RunIfLastStepFailed" Label="Run even if a previous task failed" />
                        </MudItem>
                        @if (def != null && def.SupportedTargets.Count > 1)
                        {
                            <MudItem xs="12" md="6">
                                <MudSelect T="DeploymentContextType" @bind-Value="task.TargetType" Label="Target" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var tt in def.SupportedTargets) { <MudSelectItem T="DeploymentContextType" Value="tt">@TargetTitles[tt]</MudSelectItem> }
                                </MudSelect>
                            </MudItem>
                            @if (task.TargetType == DeploymentContextType.SSH)
                            {
                                <MudItem xs="12" md="6"><MudTextField @bind-Value="task.TargetHost" Label="Remote host (host or host:port)" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                            }
                        }
                        @if (TaskCredentialType(task, def) is { } ct)
                        {
                            <MudItem xs="12" md="6">
                                <MudSelect T="string" @bind-Value="task.ChallengeCredentialKey" Label="Credentials" Variant="Variant.Outlined" Margin="Margin.Dense">
                                    @foreach (var sc in _credentials.Where(x => x.ProviderType == ct))
                                    {
                                        <MudSelectItem T="string" Value="@sc.StorageKey">@sc.Title</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                        }
                        @if (def != null)
                        {
                            <MudItem xs="12"><MudText Typo="Typo.caption" Class="mb-2 d-block">@def.Description</MudText><ParameterEditor Definitions="def.ProviderParameters" Settings="task.Parameters" /></MudItem>
                        }
                        @if (task.LastResult != null)
                        {
                            <MudItem xs="12"><MudAlert Dense="true" Severity="@(task.LastRunStatus == RequestState.Success ? Severity.Success : Severity.Warning)">Last result: @task.LastResult</MudAlert></MudItem>
                        }
                    </MudGrid>
                    <MudStack Row="true" Class="mt-2">
                        <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.PlayArrow" OnClick="@(() => RunTask(task))" Disabled="IsNew">Run now</MudButton>
                        <MudButton Size="Size.Small" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => tasks.Remove(task))">Remove task</MudButton>
                    </MudStack>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>
        <MudStack Row="true" AlignItems="AlignItems.Center">
            <MudSelect T="string" @bind-Value="_newTaskType" Label="Add task" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width:360px">
                @foreach (var p in _deploymentProviders.Where(p => !pre || p.IsPreRequestCapable))
                {
                    <MudSelectItem T="string" Value="@p.Id">@p.Title</MudSelectItem>
                }
            </MudSelect>
            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="@(() => AddTask(tasks))" Disabled="_newTaskType == null">Add</MudButton>
        </MudStack>
    };

    public void Dispose() => _poll?.Dispose();
}
